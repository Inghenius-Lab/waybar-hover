+// ── WaveCanvas ─────────────────────────────────────────────────────
+// The user's final word on the shape (2026-11-08): DOTS — round
+// like the ● of the segmented level dots — never bars, not even
+// small ones. Each column is a filled circle centered on the
+// middle line; the level drives its DIAMETER (curve v^1.35, from
+// ~3 px at rest to 20 px at full, so the big dots really read).
+// The columns are INSET from the canvas edges by the max radius,
+// so a fully grown dot is never clipped at the sides. The color
+// comes from a DYNAMIC gradient: a cyclic sweep between matugen
+// theme colors whose phase keeps rolling (a full turn in ~10 s),
+// so no dot keeps one color — the tonalities travel the row.
+
+// ── Campo de degradado aleatorio (2026-11-09) ──────────────────
+// A su pedido: nada de lineas ni patrones repetidos. El color lo
+// da un campo de NUDOS de color del tema que derivan sin prisa
+// sobre un anillo imaginario: cada nudo lleva su propia
+// velocidad, cambia de color a intervalos aleatorios y las
+// distancias entre nudos se ensanchan y se estrechan solas —
+// a veces un solo tono abarca todo, a veces una banda fina se
+// cuela entre dos anchos — sin que nada se repita con periodo
+// fijo. La mezcla entre nudos va con paso suave: sin bordes
+// duros, sin rayas. El sentido del flujo se invierte a
+// intervalos aleatorios (sale del centro / entra al centro)
+// con transicion suave, y de vez en cuando el degradado pasa
+// a vertical (lo usan las siluetas de onda y estela). UNA sola
+// instancia compartida por los dos lienzos: a igual distancia
+// del centro, el mismo color — simetria de verdad.
+struct CampoDegradado {
+  struct Nudo {
+    double pos;
+    double colorf;
+    double vel;
+    double vel_color;
+    double prox_vel;
+  };
+  std::vector<Nudo> nudos;
+  bool iniciado = false;
+  double resp_fase = 0.0;
+  double escala_ = 0.95;
+  std::mt19937 rng;
+  std::chrono::steady_clock::time_point ultimo{};
+
+  double azar(double a, double b) { return std::uniform_real_distribution<double>(a, b)(rng); }
+
+  void iniciar() {
+    rng.seed(static_cast<unsigned>(
+        std::chrono::steady_clock::now().time_since_epoch().count()));
+    const double ps[5] = {0.03, 0.30, 0.52, 0.79, 0.93};
+    const double cs[5] = {0.0, 2.0, 1.0, 2.0, 0.4};
+    for (int i = 0; i < 5; ++i) {
+      const double vc = azar(0.006, 0.016) * ((azar(0.0, 1.0) < 0.5) ? -1.0 : 1.0);
+      nudos.push_back({ps[i], cs[i], azar(0.004, 0.012), vc, azar(8.0, 20.0)});
+    }
+    iniciado = true;
+  }
+
+  void avanzar() {
+    const auto ahora = std::chrono::steady_clock::now();
+    if (!iniciado) {
+      iniciar();
+      ultimo = ahora;
+      return;
+    }
+    double dt = std::chrono::duration<double>(ahora - ultimo).count();
+    ultimo = ahora;
+    if (dt <= 0.0) {
+      return;
+    }
+    if (dt > 0.1) {
+      dt = 0.1;
+    }
+    // Respiracion (2026-11-09, a su pedido: el degradado
+    // vertical se expande y se contrae como una respiracion
+    // natural, continua): la escala oscila con un seno de
+    // periodo ~8 s entre 0,55 y 1,35. Los nudos derivan
+    // despacio y su color TAMBIEN deriva de forma continua
+    // por la paleta (colorf fraccionario): ningun cambio es
+    // discreto, asi que nada salta a la vista jamas.
+    resp_fase += dt * (2.0 * M_PI / 8.0);
+    escala_ = 0.95 + 0.40 * std::sin(resp_fase);
+    for (auto& n : nudos) {
+      n.pos = std::fmod(n.pos + n.vel * dt, 1.0);
+      if (n.pos < 0.0) {
+        n.pos += 1.0;
+      }
+      n.colorf += n.vel_color * dt;
+      n.prox_vel -= dt;
+      if (n.prox_vel <= 0.0) {
+        n.vel = azar(0.003, 0.013);
+        n.prox_vel = azar(8.0, 20.0);
+      }
+    }
+  }
+
+  // Color del campo en u (anillo [0,1)): mezcla con paso suave
+  // entre el nudo anterior y el siguiente.
+  void muestra(double u, const std::vector<std::array<double, 3>>& stops, double& r, double& g,
+               double& b) const {
+    if (nudos.empty() || stops.empty()) {
+      r = g = b = 1.0;
+      return;
+    }
+    std::vector<const Nudo*> ord;
+    ord.reserve(nudos.size());
+    for (const auto& n : nudos) {
+      ord.push_back(&n);
+    }
+    std::sort(ord.begin(), ord.end(),
+              [](const Nudo* a, const Nudo* b) { return a->pos < b->pos; });
+    u = u - std::floor(u);
+    size_t i = ord.size() - 1;
+    for (size_t k = 0; k < ord.size(); ++k) {
+      if (ord[k]->pos <= u) {
+        i = k;
+      }
+    }
+    const Nudo* a = ord[i];
+    const Nudo* bn = ord[(i + 1) % ord.size()];
+    double span = bn->pos - a->pos;
+    if (span <= 0.0) {
+      span += 1.0;
+    }
+    double du = u - a->pos;
+    if (du < 0.0) {
+      du += 1.0;
+    }
+    double f = std::clamp(du / span, 0.0, 1.0);
+    f = f * f * (3.0 - 2.0 * f);
+    double ar, ag, ab, br, bg, bb;
+    colorNudo(a->colorf, stops, ar, ag, ab);
+    colorNudo(bn->colorf, stops, br, bg, bb);
+    r = ar + (br - ar) * f;
+    g = ag + (bg - ag) * f;
+    b = ab + (bb - ab) * f;
+  }
+
+  // Color de un nudo: su posicion fraccionaria en la paleta
+  // ciclica (mezcla continua entre dos paradas vecinas).
+  void colorNudo(double cf, const std::vector<std::array<double, 3>>& stops, double& r, double& g,
+                 double& b) const {
+    const double n = static_cast<double>(stops.size());
+    double p = std::fmod(cf, n);
+    if (p < 0.0) {
+      p += n;
+    }
+    const size_t i = static_cast<size_t>(p) % stops.size();
+    const size_t j = (i + 1) % stops.size();
+    const double f = p - std::floor(p);
+    r = stops[i][0] + (stops[j][0] - stops[i][0]) * f;
+    g = stops[i][1] + (stops[j][1] - stops[i][1]) * f;
+    b = stops[i][2] + (stops[j][2] - stops[i][2]) * f;
+  }
+};
+
+CampoDegradado campo_degradado;
+
+WaveCanvas::WaveCanvas() {
+  // 33 ms tick (2026-11-11: aligned to the 30 fps data — the
+  // old 25 ms tick repainted one of every four frames with no
+  // new data under it, pure cost on a U-series CPU). It is the
+  // ONLY draw pacer, so frames land evenly. Per tick it advances the rolling phase by
+  // half the old step (same ~10 s turn) and eases the displayed
+  // dot values halfway toward the latest data frame — the
+  // interpolation the user asked for: data arrives at ~30 fps in
+  // bursts, the dots glide instead of jumping. Mic modes snap
+  // (their own designs carry their own motion).
+  Glib::signal_timeout().connect(
+      [this]() {
+        ++tick_;
+        phase_ = std::fmod(phase_ + 0.0033, 1.0);
+        if (!values_.empty()) {
+          if (disp_.size() != values_.size() || onda_ || chispas_ || simbolos_ || estela_ || rayo_ || capas_ || ramificado_ || pixel_ || constelacion_) {
+            disp_ = values_;
+          } else {
+            for (size_t i = 0; i < disp_.size(); ++i) {
+              disp_[i] += (values_[i] - disp_[i]) * 0.5;
+            }
+          }
+          // Only ask GTK for a frame while the canvas is really
+          // allocated: after silence the wave collapses to zero
+          // width, and the 40 fps draw requests kept the whole
+          // bar's main loop (and the compositor) busy forever
+          // painting an invisible widget (~20% of a core at
+          // idle). Allocation changes and the state setters
+          // request draws on their own, so the wave resumes
+          // instantly when it grows back.
+          if (get_allocation().get_width() >= 4) {
+          // Flat-wave economy (same night): with an uncorked but
+          // silent stream (a paused video still holds the sink),
+          // the wave stays open breathing at 40 fps. The breath
+          // is a slow ~8 s sine, indistinguishable at 10 fps, so
+          // while the incoming frame is flat and the estela is
+          // the design in use, three of every four draws are
+          // skipped. Any real level restores the full rate on
+          // the very next tick.
+          const bool plano = estela_ && !simbolos_ && !onda_ && !error_ &&
+                             !chispas_ && !adn_ && !panal_ && !cuerdas_ &&
+                             [&] {
+                               for (double v : values_) {
+                                 if (v > 0.02) {
+                                   return false;
+                                 }
+                               }
+                               return true;
+                             }();
+          const bool plano_rayo = rayo_ && !simbolos_ && !onda_ && !error_ &&
+                                  chispas_vivas_.empty() &&
+                                  [&] {
+                                    for (double v : values_) {
+                                      if (v > 0.02) {
+                                        return false;
+                                      }
+                                    }
+                                    return true;
+                                  }();
+          const bool plano_capas = capas_ && !simbolos_ && !onda_ && !error_ &&
+                                   [&] {
+                                     for (double v : values_) {
+                                       if (v > 0.02) {
+                                         return false;
+                                       }
+                                     }
+                                     return true;
+                                   }();
+          const bool plano_ram = ramificado_ && !simbolos_ && !onda_ && !error_ &&
+                                 chispas_ram_.empty() &&
+                                 [&] {
+                                   for (double v : values_) {
+                                     if (v > 0.02) {
+                                       return false;
+                                     }
+                                   }
+                                   return true;
+                                 }();
+          const bool plano_pixel = pixel_ && !simbolos_ && !onda_ && !error_ &&
+                                   [&] {
+                                     for (double v : values_) {
+                                       if (v > 0.02) {
+                                         return false;
+                                       }
+                                     }
+                                     return true;
+                                   }();
+          if ((!plano && !plano_rayo && !plano_capas && !plano_ram && !plano_pixel) || tick_ % 4 == 0) {
+            queue_draw();
+          }
+          }
+        }
+        return true;
+      },
+      33);
+}
