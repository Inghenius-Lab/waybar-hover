+// Anillo 3D: se pintan las mitades de atras, luego medio() (el solido) y
+// luego las de delante. A = [[puntos, alfa, grosor, cerrado]...]
+struct Anillo3D {
+  std::vector<P> pts;
+  double al, w;
+  bool cer;
+};
+template <typename Medio>
+inline void conAnillos(X& x, const std::vector<Anillo3D>& A, Medio medio, const Col& colA, const Col& colF) {
+  for (int pasada = 0; pasada < 2; pasada++) {
+    for (const auto& a : A) {
+      const size_t n = a.pts.size();
+      const size_t m = a.cer ? n : n - 1;
+      for (size_t i = 0; i < m; i++) {
+        const P& pa = a.pts[i];
+        const P& pb = a.pts[(i + 1) % n];
+        const bool del = pa[2] + pb[2] >= 0;
+        if (del != (pasada == 1)) continue;
+        x.ss = del ? colF : colA;
+        x.lw = del ? a.w : a.w * .7;
+        tira(x, {pa, pb}, del ? a.al : a.al * (x.chico ? .3 : .45));
+      }
+    }
+    if (pasada == 0) {
+      x.ga = 1;
+      medio();
+    }
+  }
+  x.ga = 1;
+  x.ambos(x.pal.verde);
+}
