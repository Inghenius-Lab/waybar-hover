+
+bool WaveCanvas::gradientColor(double t, double& r, double& g, double& b) {
+  if (gradient_.size() < 2) {
+    return resolveColor(gradient_.empty() ? color_ : gradient_.front(), r, g, b);
+  }
+  // La orientacion de siempre (aclaracion suya, 2026-11-09):
+  // el color corre A LO LARGO de la onda, medido como distancia
+  // al centro (el lienzo izquierdo la mide al reves: a igual
+  // distancia, el mismo color). La muestra va escalada por la
+  // respiracion: el patron de color se expande y se contrae
+  // desde el centro, continuo y sin saltos.
+  campo_degradado.avanzar();
+  const double s = inner_right_ ? 1.0 - std::clamp(t, 0.0, 1.0)
+                                : std::clamp(t, 0.0, 1.0);
+  return campoColor(s * campo_degradado.escala_, r, g, b);
+}
+
+// Paradas del tema en orden canonico fijo (acento, contenedor,
+// terciario), resueltas como mucho dos veces por segundo: los
+// dos lienzos comparten asi exactamente los mismos colores.
+const std::vector<std::array<double, 3>>* WaveCanvas::paradas() {
+  if (!stops_ok_ || tick_ - stops_tick_ >= 20) {
+    static const char* const CANON[3] = {"waybar-accent", "waybar-primary-container",
+                                         "waybar-tertiary"};
+    stops_cache_.clear();
+    for (const char* name : CANON) {
+      double sr, sg, sb;
+      if (resolveColor(name, sr, sg, sb)) {
+        stops_cache_.push_back({sr, sg, sb});
+      }
+    }
+    stops_tick_ = tick_;
+    stops_ok_ = true;
+  }
+  if (stops_cache_.empty()) {
+    return nullptr;
+  }
+  return &stops_cache_;
+}
+
+// Color del campo aleatorio compartido en la coordenada u (sin
+// espejo: u ya viene medida como la necesita quien llama).
+bool WaveCanvas::campoColor(double u, double& r, double& g, double& b) {
+  const auto* stops = paradas();
+  if (stops == nullptr) {
+    return false;
+  }
+  if (stops->size() == 1) {
+    r = (*stops)[0][0];
+    g = (*stops)[0][1];
+    b = (*stops)[0][2];
+    return true;
+  }
+  campo_degradado.avanzar();
+  campo_degradado.muestra(u, *stops, r, g, b);
+  return true;
+}
+
+// Muestra VERTICAL del campo para las siluetas (onda y estela):
+// la coordenada es la distancia a la linea central del lienzo,
+// escalada por la respiracion — el degradado se expande y se
+// contrae desde el centro, igual en los dos lienzos.
+bool WaveCanvas::campoColorVertical(double y, double h, double& r, double& g, double& b) {
+  const auto* stops = paradas();
+  if (stops == nullptr) {
+    return false;
+  }
+  if (stops->size() == 1) {
+    r = (*stops)[0][0];
+    g = (*stops)[0][1];
+    b = (*stops)[0][2];
+    return true;
+  }
+  campo_degradado.avanzar();
+  const double d = std::clamp(std::abs(y - h / 2.0) / (h / 2.0), 0.0, 1.0);
+  campo_degradado.muestra(d * campo_degradado.escala_, *stops, r, g, b);
+  return true;
+}
+
+void WaveCanvas::setValues(const std::vector<double>& values) {
+  if (values.size() == values_.size()) {
+    bool same = true;
+    for (size_t i = 0; i < values.size(); ++i) {
+      if (std::abs(values[i] - values_[i]) > 0.004) {
+        same = false;
+        break;
+      }
+    }
+    if (same) {
+      return;
+    }
+  }
+  values_ = values;
+  hist_.push_back(values);
+  if (hist_.size() > 12) {
+    hist_.erase(hist_.begin());
+  }
+  if (disp_.size() != values_.size()) {
+    disp_ = values_;
+  }
+  // No queue_draw here (2026-11-09): the 25 ms canvas tick paces
+  // every frame evenly; drawing on arrival made the pacing bursty.
+}
+
+bool WaveCanvas::resolveColor(const std::string& name, double& r, double& g, double& b) {
+  GdkRGBA named{};
+  if (gtk_style_context_lookup_color(get_style_context()->gobj(), name.c_str(), &named)) {
+    r = named.red;
+    g = named.green;
+    b = named.blue;
+    return true;
+  }
+  GdkRGBA rgba{};
+  if (gdk_rgba_parse(&rgba, name.c_str())) {
+    r = rgba.red;
+    g = rgba.green;
+    b = rgba.blue;
+    return true;
+  }
+  return false;
+}
+
+bool WaveCanvas::on_draw(const Cairo::RefPtr<Cairo::Context>& cr) {
+  const auto alloc = get_allocation();
+  const double w = alloc.get_width();
+  const double h = alloc.get_height();
+  const size_t n = values_.size();
+  if (w < 4 || h < 4 || n == 0) {
+    return false;
+  }
+  const double mid = h / 2.0;
+  if (simbolos_) {
+    drawSimbolos(cr, w, h);
+    return false;
+  }
+  if (chispas_) {
+    drawChispas(cr, w, h);
+    return false;
+  }
+  if (onda_) {
+    drawOnda(cr, w, h);
+    return false;
+  }
+  if (cuerdas_) {
+    drawCuerdas(cr, w, h);
+    return false;
+  }
+  if (adn_) {
+    drawAdn(cr, w, h);
+    return false;
+  }
+  if (panal_) {
+    drawPanal(cr, w, h);
+    return false;
+  }
+  if (hexagonos_) {
+    drawHexagonos(cr, w, h);
+    return false;
+  }
+  if (oleaje_) {
+    drawOleaje(cr, w, h);
+    return false;
+  }
+  if (pixel_) {
+    drawPixel(cr, w, h);
+    return false;
+  }
+  if (constelacion_) {
+    drawConstelacion(cr, w, h);
+    return false;
+  }
+  if (ramificado_) {
+    drawRamificado(cr, w, h);
+    return false;
+  }
+  if (capas_) {
+    drawCapas(cr, w, h);
+    return false;
+  }
+  if (rayo_) {
+    drawRayo(cr, w, h);
+    return false;
+  }
+  // SIN MODO / MODO BORRADO (2026-11-09, orden suya): el diseno
+  // de PUNTOS que vivia aqui como caida por defecto queda
+  // ELIMINADO del binario — volvio solo cuando un reinicio
+  // borro el fichero de modo de /tmp y no debe reaparecer
+  // jamas. Toda clase de musica sin diseno nombrado dibuja la
+  // ESTELA (T3, su diseno vigente), igual que la clase "estela".
+  drawEstela(cr, w, h);
+  return false;
+}
+
+
+// ── Onda con estela (dictado; eleccion del usuario, 2026-11-08) ──
+// Silueta LLENA en tres capas: la onda actual delante y dos
+// fotogramas anteriores detras, mas gruesos y mas transparentes
+// (la estela). El grosor sigue al nivel interpolado suave entre
+// las 8 bandas. BORDES: el grosor y el alfa se desvanecen con un
+// smoothstep en el 16 % externo de cada lado — la onda nunca se
+// corta feo contra el borde del lienzo, se apaga antes de llegar.
+// El color es el degradado dinamico de siempre (fase rodante),
+// fijo en todos los disenos, como pidio el usuario.
+void WaveCanvas::drawOnda(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  struct Capa {
+    size_t ago;
+    double factor;
+    double alfa;
+  };
+  const Capa capas[3] = {{6, 1.55, 0.15}, {3, 1.25, 0.30}, {0, 0.90, 0.95}};
+  const double margen = 4.0;
+  const double util = w - 2 * margen;
+  const double paso = util / (M - 1);
+  for (const auto& capa : capas) {
+    const std::vector<double>* src = &values_;
+    if (capa.ago > 0 && hist_.size() > capa.ago) {
+      src = &hist_[hist_.size() - 1 - capa.ago];
+    }
+    const auto sm = muestras(*src);
+    for (int i = 0; i < M; ++i) {
+      const double t = static_cast<double>(i) / (M - 1);
+      const double x = margen + t * util;
+      const double borde = std::min(t, 1.0 - t) / 0.16;
+      const double ec = std::clamp(borde, 0.0, 1.0);
+      const double taper = ec * ec * (3.0 - 2.0 * ec);
+      const double v = std::clamp(sm[i], 0.0, 1.0);
+      const double th = (1.2 + v * (h - 9.0)) * capa.factor * (0.10 + 0.90 * taper);
+      double r, g, b;
+      if (!gradientColor(t, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      cr->set_source_rgba(r, g, b, capa.alfa * (0.20 + 0.80 * taper));
+      cr->rectangle(x - paso / 2 - 0.4, mid - th / 2, paso + 0.8, th);
+      cr->fill();
+    }
+  }
+}
+
+
+// ── Estela larga (musica; variante T3 de la onda, 2026-11-09) ─
+// La misma silueta de la onda del dictado (drawOnda no se toca:
+// es el diseno cerrado del micro), pero con CINCO capas de
+// historia en vez de tres: la estela se alarga y se suaviza
+// (atrasos 10/7/4/2/0, grosores crecientes hacia atras, alfas
+// decrecientes). Solo para la musica, clase «estela».
+void WaveCanvas::drawEstela(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  struct Capa {
+    size_t ago;
+    double factor;
+    double alfa;
+  };
+  const Capa capas[5] = {{10, 1.85, 0.08}, {7, 1.66, 0.13}, {4, 1.45, 0.20}, {2, 1.20, 0.33}, {0, 0.92, 0.95}};
+  const double margen = 4.0;
+  const double util = w - 2 * margen;
+  const double paso = util / (M - 1);
+  for (const auto& capa : capas) {
+    const std::vector<double>* src = &values_;
+    if (capa.ago > 0 && hist_.size() > capa.ago) {
+      src = &hist_[hist_.size() - 1 - capa.ago];
+    }
+    const auto sm = muestras(*src);
+    for (int i = 0; i < M; ++i) {
+      const double t = static_cast<double>(i) / (M - 1);
+      const double x = margen + t * util;
+      const double borde = std::min(t, 1.0 - t) / 0.16;
+      const double ec = std::clamp(borde, 0.0, 1.0);
+      const double taper = ec * ec * (3.0 - 2.0 * ec);
+      const double v = std::clamp(sm[i], 0.0, 1.0);
+      const double th = (1.2 + v * (h - 9.0)) * capa.factor * (0.10 + 0.90 * taper);
+      double r, g, b;
+      if (!gradientColor(t, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      cr->set_source_rgba(r, g, b, capa.alfa * (0.20 + 0.80 * taper));
+      cr->rectangle(x - paso / 2 - 0.4, mid - th / 2, paso + 0.8, th);
+      cr->fill();
+    }
+  }
+}
