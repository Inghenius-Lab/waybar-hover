+// v6 · ESCUCHANDO en 3D (modo voz).
+// A: icosaedro abierto que inhala: los anillos 3D vienen de fuera y entran en la esferita.
+inline void i_escuchando_a(X& x, double t) {
+  auto T = [&](const P& p) { return pr(rX(rY(p, .3 * std::sin(t * .6)), x.chico ? .98 : 1.13)); };
+  std::vector<Anillo3D> A;
+  const int n = x.chico ? 2 : 3;
+  double pul = 0;
+  for (int i = 0; i < n; i++) {
+    const double p = std::fmod(t * .5 + i / (double)n, 1.0);
+    pul = std::max(pul, std::max(std::exp(-(1 - p) * 7), std::exp(-p * 9)));
+    A.push_back({anillo(30 - (x.chico ? 16 : 19.5) * p, x.chico ? 18 : 28, T),
+                 std::min(1.0, p * 4) * std::min(1.0, (1 - p) * 4), (x.chico ? 2.3 : 1.6) + .9 * p, true});
+  }
+  conAnillos(x, A,
+             [&] {
+               alambre(x, x.chico ? octaedro() : icosaedro().s, 13.5 - 1.3 * pul, -t * .7, .3, 1, x.pal.verde,
+                       3.2 + 2.2 * pul);
+             },
+             x.pal.azul, x.pal.verde);
+}
+// B: parabola 3D que recibe: la senal baja en anillos hasta el foco.
+inline void i_escuchando_b(X& x, double t) {
+  const double gy = .72 + .14 * std::sin(t * .7), gx = .5 + .06 * std::sin(t * 1.1);
+  auto T = [&](const P& p) { return pr(rX(rY(p, gy), gx), -7, 8); };
+  const double Rd = 17, dp = 7, fz = 10.5;
+  auto bol = [&](double r, double a) {
+    return P{r * std::cos(a), r * std::sin(a), -dp * (1 - r * r / (Rd * Rd))};
+  };
+  x.ss = x.pal.azul;
+  x.lw = 1.3;
+  if (!x.chico) {
+    for (int i = 0; i < 6; i++) {
+      const double a = i * TAU / 6;
+      std::vector<P> pts;
+      for (double f : {0.0, .35, .7, 1.0}) pts.push_back(T(bol(Rd * f, a)));
+      tira(x, pts, .55);
+    }
+  }
+  x.lw = 1.5;
+  tira(x, anillo(Rd * .58, 20, [&](const P& p) { return T(bol(Rd * .58, std::atan2(p[1], p[0]))); }),
+       x.chico ? .45 : .7, true);
+  x.ss = x.pal.verde;
+  x.lw = 2.5;
+  const auto borde = anillo(Rd, 26, [&](const P& p) { return T({p[0], p[1], 0}); });
+  tira(x, borde, 1, true);
+  tapar(x, borde);
+  x.lw = 1.5;
+  for (int i = 0; i < 3; i++) {
+    const double a = PI / 2 + i * TAU / 3;
+    tira(x, {T({Rd * std::cos(a), Rd * std::sin(a), 0}), T({0, 0, fz})}, .85);
+  }
+  x.lw = 2.2;
+  tira(x, {T({0, 0, -dp}), T({0, 13, -dp - 9})}, .9);  // soporte
+  for (int i = 0; i < 3; i++) {
+    const double p = std::fmod(t * .55 + i / 3.0, 1.0), d = fz + 25 * (1 - p);
+    x.lw = 2.4 - 1 * (1 - p);
+    tira(x, anillo(2.5 + 9.5 * (1 - p), x.chico ? 14 : 20, [&](const P& q) { return T({q[0], q[1], d}); }),
+         std::min(1.0, p * 5) * std::min(1.0, (1 - p) * 6), true);
+  }
+  const P f = T({0, 0, fz});
+  x.ga = 1;
+  x.fs = x.pal.blanco;
+  circ(x, f[0], f[1], 2.3 + .8 * std::abs(std::sin(t * 3.4)), true);
+  x.fs = x.pal.verde;
+  x.ga = 1;
+}
+// C: vortice: hexagonos 3D que vienen de fuera y caen girando en la esferita.
+inline void i_escuchando_c(X& x, double t) {
+  auto T = [&](const P& p) { return pr(rX(rY(p, .38 * std::sin(t * .6)), .3 + .1 * std::sin(t * .9))); };
+  const int n = x.chico ? 3 : 4;
+  struct Hex {
+    double z;
+    std::vector<P> pts;
+    double al, w, p;
+  };
+  std::vector<Hex> L;
+  double pul = 0;
+  for (int i = 0; i < n; i++) {
+    const double p = std::fmod(t * .42 + i / (double)n, 1.0);
+    const double r = 4.5 + 23.5 * std::pow(1 - p, 1.25), z = 15 - 37 * p, g = p * 1.3;
+    std::vector<P> P;
+    for (int j = 0; j < 6; j++) {
+      const double a = -PI / 2 + g + j * TAU / 6;
+      P.push_back(T({r * std::cos(a), r * std::sin(a), z}));
+    }
+    pul = std::max(pul, std::exp(-(1 - p) * 8));
+    L.push_back({z, P, std::min(1.0, p * 5) * std::min(1.0, (1 - p) * 3.5), 1.3 + 1.5 * (1 - p), p});
+  }
+  std::stable_sort(L.begin(), L.end(), [](const Hex& a, const Hex& b) { return a.z < b.z; });
+  bool hecho = false;
+  auto bola = [&] {
+    if (!hecho) {
+      hecho = true;
+      x.ga = 1;
+      esferita(x, 3.2 + 2.2 * pul, 1, x.pal.verde);
+    }
+  };
+  for (const auto& e : L) {
+    if (e.z > -2) bola();
+    x.ss = e.p > .55 ? x.pal.azul : x.pal.verde;
+    x.lw = e.w;
+    tira(x, e.pts, e.al, true);
+  }
+  bola();
+  x.ga = 1;
+  x.ss = x.pal.verde;
+}
+
+inline void i_pensando(X& x, double t) {
+  auto T = [&](const P& p) { return pr(rX(rY(p, t * 1.5), .38)); };
+  std::array<P, 4> V;
+  V[0] = T({0, -16.5, 0});
+  for (int i = 0; i < 3; i++) {
+    const double a = i * TAU / 3;
+    V[i + 1] = T({15.5 * std::cos(a), 5.5, 15.5 * std::sin(a)});
+  }
+  const int idx[6][2] = {{0, 1}, {0, 2}, {0, 3}, {1, 2}, {2, 3}, {3, 1}};
+  std::vector<std::array<P, 2>> E;
+  for (const auto& e : idx) E.push_back({V[e[0]], V[e[1]]});
+  std::stable_sort(E.begin(), E.end(), [](const std::array<P, 2>& p, const std::array<P, 2>& q) {
+    return p[0][2] + p[1][2] < q[0][2] + q[1][2];
+  });
+  x.lw = 2.4;
+  size_t k = 0;
+  for (; k < 3; k++) seg(x, E[k][0], E[k][1], 11);
+  x.ga = 1;
+  circ(x, C, C + 1, 2.2, true);
+  for (; k < 6; k++) seg(x, E[k][0], E[k][1], 11);
+  x.ga = 1;
+}
+
+inline void i_cerebro(X& x, double t) {
+  const double gy = t * .9, E = 1.22, rx = 8.6, rz = 14, g = 1.3;
+  auto T = [&](const P& p) { return pr(rX(rY({p[0] * E, p[1] * E, p[2] * E}, gy), -.3), 0, -1.5); };
+  const double W = std::sqrt(100 * std::cos(gy) * std::cos(gy) + 196 * std::sin(gy) * std::sin(gy));
+  x.ga = .13;
+  x.begin();
+  x.ellipse(C, C - 2.5, W * E, 9.4 * E, 0, 0, TAU);
+  x.fill();
+  struct Pz {
+    P a, b;
+    double z, w;
+  };
+  std::vector<Pz> piezas;
+  piezas.reserve(224);
+  for (int si = 0; si < 2; si++) {
+    const double s = si == 0 ? -1 : 1;
+    for (int j = 0; j < 7; j++) {
+      const double psi0 = -1.5 + j * .5;
+      std::array<P, 17> pts;
+      std::array<double, 17> nz;
+      for (int i = 0; i <= 16; i++) {
+        const double fi = .1 + (PI - .2) * i / 16.0, on = j == 0 ? 0 : 1;
+        const double psi = psi0 + on * .19 * std::sin(6 * fi + j * 1.9 + s);
+        const double b = 1 + on * .05 * std::sin(9 * fi + j * 2.3);
+        const double sy = std::sin(fi) * std::sin(psi);
+        const P q = {s * (g + rx * b * std::sin(fi) * std::max(0.0, std::cos(psi))),
+                     (sy < 0 ? 10 : 7) * b * sy, rz * b * std::cos(fi)};
+        pts[i] = T(q);
+        nz[i] = rX(rY({q[0] - s * g, q[1], q[2] * .6}, gy), -.3)[2];
+      }
+      for (int i = 0; i < 16; i++) piezas.push_back({pts[i], pts[i + 1], (nz[i] + nz[i + 1]) / 2, j == 0 ? 2.0 : 1.5});
+    }
+  }
+  auto Tc = [&](const P& p) { return T({p[0], p[1] + 7, p[2] - 9.5}); };
+  x.lw = 1.3;
+  poli(x, anillo(1, 12, [&](const P& p) { return Tc({p[0] * 6, p[2], p[1] * 4.5}); }), 16, .7, true);
+  poli(x, anillo(1, 12, [&](const P& p) { return Tc({p[0] * 6, p[1] * 3.6, 0}); }), 16, .7, true);
+  x.lw = 2;
+  seg(x, T({0, 6.5, -4}), T({0, 13, -5.5}), 16, .9);
+  std::stable_sort(piezas.begin(), piezas.end(), [](const Pz& p, const Pz& q) { return p.z < q.z; });
+  for (const auto& p : piezas) {
+    x.lw = p.w;
+    x.ga = p.z < 0 ? .15 : std::min(1.0, .5 + p.z / 9);
+    x.begin();
+    x.mt(p.a[0], p.a[1]);
+    x.lt(p.b[0], p.b[1]);
+    x.stroke();
+  }
+  x.ga = 1;
+}
+
+inline void i_ejecutando(X& x, double t) {
+  Tr T = [&](const P& p) { return pr(rY(rX(p, .72), .4 * std::sin(t * .8)), 0, 1); };
+  struct G {
+    double z, ox, oy, r;
+    int n;
+    double ang;
+  };
+  std::array<G, 2> gs = {{{0, -4.5, 3.5, 11.5, 9, t * 1.1}, {0, 8.2, -6.5, 7.5, 6, -t * 1.65 + .32}}};
+  for (auto& e : gs) e.z = T({e.ox, e.oy, 0})[2];
+  if (gs[1].z < gs[0].z) std::swap(gs[0], gs[1]);
+  for (const auto& e : gs) engranaje(x, e.ox, e.oy, e.r, e.n, e.ang, T);
+}
