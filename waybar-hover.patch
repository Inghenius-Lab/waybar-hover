+// ── Rayo con chispas (musica y dictado; diseno 5 de la tanda
+// de rayos, eleccion del usuario, 2026-11-11) ──────────────────
+// Una linea electrica fina que crepita con la senal: el
+// desplazamiento de cada punto mezcla una onda lenta con un
+// ruido seco por fotograma proporcional al nivel, y de la
+// propia linea saltan chispas que suben, caen con gravedad y
+// se apagan en unas decimas, tantas mas cuanto mayor es el
+// nivel. BORDES como en la onda y la estela: smoothstep en el
+// 16 % externo — en los bordes la linea aterriza en el centro
+// y ahi no nacen chispas: nunca se ve cortada. El color es el
+// degradado dinamico de siempre, por tramo; lleva un nucleo
+// fino aclarado hacia el blanco y las chispas heredan el
+// color del punto donde nacen.
+void WaveCanvas::drawRayo(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  auto ruido = [](double semilla) {
+    const double x = std::sin(semilla) * 43758.5453;
+    return (x - std::floor(x)) * 2.0 - 1.0;
+  };
+  const auto sm = muestras(values_);
+  const double margen = 4.0;
+  const double util = w - 2 * margen;
+  std::vector<double> xs(M), ys(M), vs(M);
+  double vmax = 0.0;
+  for (int i = 0; i < M; ++i) {
+    const double t = static_cast<double>(i) / (M - 1);
+    const double borde = std::min(t, 1.0 - t) / 0.16;
+    const double ec = std::clamp(borde, 0.0, 1.0);
+    const double taper = ec * ec * (3.0 - 2.0 * ec);
+    const double v = std::clamp(sm[i], 0.0, 1.0);
+    vs[i] = v * taper;
+    vmax = std::max(vmax, v);
+    const double amp = v * (h * 0.40) * taper;
+    xs[i] = margen + t * util;
+    ys[i] = mid + (std::sin(t * 9.0 - tick_ * 0.30) * 0.35 +
+                   ruido(i * 127.1 + tick_ * 311.7) * 0.38 -
+                   std::sin(t * 3.0 + tick_ * 0.10) * 0.72) * amp;
+  }
+  // Chispas: nacen de la linea segun el nivel medio/alto.
+  spawn_acc_ += vmax * 2.4;
+  while (spawn_acc_ >= 1.0 && chispas_vivas_.size() < 90) {
+    spawn_acc_ -= 1.0;
+    int idx = -1;
+    for (int intento = 0; intento < 4 && idx < 0; ++intento) {
+      const int cand = static_cast<int>(
+          (ruido(tick_ * 17.3 + intento * 91.7 + spawn_acc_ * 13.1) * 0.5 + 0.5) * (M - 1));
+      if (cand >= 0 && cand < M && vs[cand] > 0.12) {
+        idx = cand;
+      }
+    }
+    if (idx < 0) {
+      continue;
+    }
+    const double t = static_cast<double>(idx) / (M - 1);
+    double r, g, b;
+    if (!gradientColor(t, r, g, b)) {
+      r = g = b = 1.0;
+    }
+    ChispaViva c;
+    c.x = xs[idx];
+    c.y = ys[idx];
+    c.vx = ruido(idx * 3.7 + tick_ * 7.9) * 0.45;
+    c.vy = -(0.35 + (ruido(idx * 9.3 + tick_ * 3.1) * 0.5 + 0.5) * 0.85);
+    c.vida0 = 8 + static_cast<int>((ruido(idx * 5.1 + tick_) * 0.5 + 0.5) * 6);
+    c.vida = c.vida0;
+    c.rgb = {r, g, b};
+    chispas_vivas_.push_back(c);
+  }
+  std::vector<ChispaViva> vivas;
+  vivas.reserve(chispas_vivas_.size());
+  for (auto& c : chispas_vivas_) {
+    c.x += c.vx;
+    c.y += c.vy;
+    c.vy += 0.055;
+    c.vida -= 1;
+    if (c.vida > 0 && c.x > -2 && c.x < w + 2 && c.y > -2 && c.y < h + 2) {
+      vivas.push_back(c);
+    }
+  }
+  chispas_vivas_.swap(vivas);
+  for (const auto& c : chispas_vivas_) {
+    const double a = 0.9 * static_cast<double>(c.vida) / c.vida0;
+    cr->set_source_rgba(c.rgb[0], c.rgb[1], c.rgb[2], a);
+    cr->arc(c.x, c.y, 1.0, 0, 2 * M_PI);
+    cr->fill();
+  }
+  // La linea: trazo por tramos con el degradado, y nucleo claro.
+  cr->set_line_cap(Cairo::LINE_CAP_ROUND);
+  cr->set_line_join(Cairo::LINE_JOIN_ROUND);
+  for (int pasada = 0; pasada < 2; ++pasada) {
+    cr->set_line_width(pasada == 0 ? 1.5 : 0.7);
+    for (int i = 0; i + 1 < M; ++i) {
+      const double t = static_cast<double>(i) / (M - 1);
+      double r, g, b;
+      if (!gradientColor(t, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      if (pasada == 1) {
+        r += (1.0 - r) * 0.62;
+        g += (1.0 - g) * 0.62;
+        b += (1.0 - b) * 0.62;
+        cr->set_source_rgba(r, g, b, 0.80);
+      } else {
+        cr->set_source_rgba(r, g, b, 0.95);
+      }
+      cr->move_to(xs[i], ys[i]);
+      cr->line_to(xs[i + 1], ys[i + 1]);
+      cr->stroke();
+    }
+  }
+}
