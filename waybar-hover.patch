@@ -0,0 +1,122 @@
+#pragma once
+
+#include <chrono>
+#include <string>
+#include <vector>
+
+#include "AModule.hpp"
+#include "util/command.hpp"
+#include "util/command_line_stream.hpp"
+#include "util/json.hpp"
+#include "util/sleeper_thread.hpp"
+
+namespace waybar::modules {
+
+// Local module (2026-11-08): a circular percentage ring drawn with
+// Cairo around a centered icon glyph — stock Waybar has no way to
+// draw one. Data comes from an exec command returning the usual
+// custom-module JSON plus "percentage". Colors are looked up BY NAME
+// from the live GTK theme at draw time (the @define-color palette
+// that matugen regenerates into the bar's colors.css), so the ring
+// re-themes with the rest of the bar instead of freezing a palette
+// in code. The icon is drawn by the canvas itself (Pango + Cairo),
+// centered by its INK extents — a label centers the glyph's advance
+// box, whose bearings leave the visible glyph slightly off-center.
+// Registered in the factory as "ring/<name>".
+class RingCanvas : public Gtk::DrawingArea {
+ public:
+  RingCanvas();
+  void setPercentage(double pct);
+  void setGradient(std::vector<std::string> stops);
+  void setThickness(double px);
+  void setSmooth(bool smooth);
+  void setTrackAlpha(double alpha);
+  void setArcColor(const std::string& spec);
+  void setIcon(const std::string& glyph, const std::string& color_spec);
+
+ protected:
+  bool on_draw(const Cairo::RefPtr<Cairo::Context>& cr) override;
+
+ private:
+  bool resolveColor(const std::string& name, double& r, double& g, double& b);
+  void arcColor(double pct, double& r, double& g, double& b);
+  void drawIcon(const Cairo::RefPtr<Cairo::Context>& cr, double cx, double cy, double diameter);
+  bool tick();
+
+  double target_ = 0.0;
+  double shown_ = 0.0;
+  double thickness_ = 3.0;
+  double track_alpha_ = 0.22;
+  bool smooth_ = true;
+  std::string arc_color_;
+  std::vector<std::string> stops_{"waybar-tertiary", "waybar-source", "waybar-primary-container"};
+  std::string icon_glyph_;
+  std::string icon_color_{"waybar-accent"};
+  sigc::connection anim_;
+};
+
+class Ring : public AModule {
+ public:
+  Ring(const std::string&, const std::string&, const Json::Value&, const std::string&);
+  ~Ring() override;
+  auto update() -> void override;
+  void refresh(int /*signal*/) override;
+
+ private:
+  void delayWorker();
+  void waitingWorker();
+  void continuousWorker();
+  void startContinuousProcess(bool throw_on_failure);
+  void handleContinuousProcessExit(int exit_code);
+  void scheduleContinuousRestart();
+  void handleEvent();
+  bool handleScroll(GdkEventScroll* e) override;
+  bool handleToggle(GdkEventButton* const& e) override;
+  void parseOutputJson();
+
+  // Parchment reveal for the level bar (user's spec, 2026-11-08):
+  // the bar unrolls/rolls by animating the explicit width of the
+  // clip box that holds the label. The firm requested width also
+  // ends the clipped last dot: with the label as a merely packed
+  // child, a full bar (two/three bars open at once) squeezed its
+  // allocation and the final dot was cut mid-glyph.
+  // The tween runs on the FRAME CLOCK with an easeInOutSine
+  // curve (750 ms open / 650 ms close): the first exponential
+  // lerp lurched and dragged, and a 420 ms cubic still read as
+  // brusque to the user's eye — slow and gentle wins here.
+  // Frame-synced eased steps are what make it fluid.
+  void startBarReveal(double target, int dur_ms);
+  bool barTick(const Glib::RefPtr<Gdk::FrameClock>& clock);
+  enum class BarState { Closed, Opening, Open, Closing };
+  BarState bar_state_ = BarState::Closed;
+  double bar_shown_w_ = 0.0;
+  double bar_from_w_ = 0.0;
+  double bar_target_w_ = 0.0;
+  gint64 bar_t0_us_ = 0;
+  int bar_dur_ms_ = 0;
+  guint bar_tick_id_ = 0;
+  std::string bar_current_;
+
+  const std::string name_;
+  const std::string output_name_;
+  std::chrono::seconds interval_{0};
+
+  Gtk::Box wrap_;
+  RingCanvas canvas_;
+  Gtk::Box bar_box_;
+  Gtk::Label bar_label_;
+
+  std::string text_;
+  std::string tooltip_;
+  std::string bar_;
+  std::string icon_color_json_;
+  std::vector<std::string> class_;
+  int percentage_ = 0;
+  util::command::res output_;
+  util::JsonParser parser_;
+  std::unique_ptr<util::command::LineStream> continuous_stream_;
+  sigc::connection restart_connection_;
+  util::SleeperThread thread_;
+};
+
+}  // namespace waybar::modules
