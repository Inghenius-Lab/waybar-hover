+
+bool WaveCanvas::gradientColor(double t, double& r, double& g, double& b) {
+  if (gradient_.size() < 2) {
+    return resolveColor(gradient_.empty() ? color_ : gradient_.front(), r, g, b);
+  }
+  // Cached stops (2026-11-09): resolve at most twice a second;
+  // a matugen theme swap reloads the bar anyway, so staleness is
+  // bounded and invisible.
+  if (!stops_ok_ || tick_ - stops_tick_ >= 20) {
+    stops_cache_.clear();
+    for (auto const& name : gradient_) {
+      double sr, sg, sb;
+      if (resolveColor(name, sr, sg, sb)) {
+        stops_cache_.push_back({sr, sg, sb});
+      }
+    }
+    stops_tick_ = tick_;
+    stops_ok_ = true;
+  }
+  const std::vector<std::array<double, 3>>& stops = stops_cache_;
+  if (stops.empty()) {
+    return false;
+  }
+  if (stops.size() == 1) {
+    r = stops[0][0];
+    g = stops[0][1];
+    b = stops[0][2];
+    return true;
+  }
+  // Cyclic: the sweep wraps from the last stop back to the first,
+  // and the rolling phase_ shifts every column's position in the
+  // cycle, so the colors travel instead of sitting still.
+  const double pos = std::fmod(std::clamp(t, 0.0, 1.0) + phase_, 1.0) *
+                     static_cast<double>(stops.size());
+  const size_t idx = static_cast<size_t>(pos) % stops.size();
+  const size_t nxt = (idx + 1) % stops.size();
+  const double f = pos - std::floor(pos);
+  r = stops[idx][0] + (stops[nxt][0] - stops[idx][0]) * f;
+  g = stops[idx][1] + (stops[nxt][1] - stops[idx][1]) * f;
+  b = stops[idx][2] + (stops[nxt][2] - stops[idx][2]) * f;
+  return true;
+}
+
+void WaveCanvas::setValues(const std::vector<double>& values) {
+  if (values.size() == values_.size()) {
+    bool same = true;
+    for (size_t i = 0; i < values.size(); ++i) {
+      if (std::abs(values[i] - values_[i]) > 0.004) {
+        same = false;
+        break;
+      }
+    }
+    if (same) {
+      return;
+    }
+  }
+  values_ = values;
+  hist_.push_back(values);
+  if (hist_.size() > 12) {
+    hist_.erase(hist_.begin());
+  }
+  if (disp_.size() != values_.size()) {
+    disp_ = values_;
+  }
+  // No queue_draw here (2026-11-09): the 25 ms canvas tick paces
+  // every frame evenly; drawing on arrival made the pacing bursty.
+}
+
+bool WaveCanvas::resolveColor(const std::string& name, double& r, double& g, double& b) {
+  GdkRGBA named{};
+  if (gtk_style_context_lookup_color(get_style_context()->gobj(), name.c_str(), &named)) {
+    r = named.red;
+    g = named.green;
+    b = named.blue;
+    return true;
+  }
+  GdkRGBA rgba{};
+  if (gdk_rgba_parse(&rgba, name.c_str())) {
+    r = rgba.red;
+    g = rgba.green;
+    b = rgba.blue;
+    return true;
+  }
+  return false;
+}
+
+bool WaveCanvas::on_draw(const Cairo::RefPtr<Cairo::Context>& cr) {
+  const auto alloc = get_allocation();
+  const double w = alloc.get_width();
+  const double h = alloc.get_height();
+  const size_t n = values_.size();
+  if (w < 4 || h < 4 || n == 0) {
+    return false;
+  }
+  const double mid = h / 2.0;
+  if (simbolos_) {
+    drawSimbolos(cr, w, h);
+    return false;
+  }
+  if (chispas_) {
+    drawChispas(cr, w, h);
+    return false;
+  }
+  if (onda_) {
+    drawOnda(cr, w, h);
+    return false;
+  }
+  if (cuerdas_) {
+    drawCuerdas(cr, w, h);
+    return false;
+  }
+  if (adn_) {
+    drawAdn(cr, w, h);
+    return false;
+  }
+  if (panal_) {
+    drawPanal(cr, w, h);
+    return false;
+  }
+  if (hexagonos_) {
+    drawHexagonos(cr, w, h);
+    return false;
+  }
+  if (oleaje_) {
+    drawOleaje(cr, w, h);
+    return false;
+  }
+  if (estela_) {
+    drawEstela(cr, w, h);
+    return false;
+  }
+  const double min_d = 3.2;
+  const double max_d = std::min(20.0, h - 6.0);
+  // Inset the columns by the max radius (+1 px of air) so the
+  // first and last dots are always drawn complete, never clipped
+  // by the canvas edges when they grow.
+  const double inset = max_d / 2.0 + 1.0;
+  if (w < 2 * inset + 4) {
+    return false;
+  }
+  const double span = w - 2 * inset;
+
+  for (size_t i = 0; i < n; ++i) {
+    const double v = std::clamp(disp_.size() == n ? disp_[i] : values_[i], 0.0, 1.0);
+    const double t = n > 1 ? static_cast<double>(i) / static_cast<double>(n - 1) : 0.5;
+    const double cx = inset + span * t;
+    double r, g, b;
+    if (!gradientColor(t, r, g, b)) {
+      r = g = b = 1.0;
+    }
+    cr->set_source_rgba(r, g, b, 0.92);
+    const double d = min_d + std::pow(v, 1.35) * (max_d - min_d);
+    cr->arc(cx, mid, d / 2.0, 0, 2 * M_PI);
+    cr->fill();
+  }
+  return false;
+}
+
+
+// ── Onda con estela (dictado; eleccion del usuario, 2026-11-08) ──
+// Silueta LLENA en tres capas: la onda actual delante y dos
+// fotogramas anteriores detras, mas gruesos y mas transparentes
+// (la estela). El grosor sigue al nivel interpolado suave entre
+// las 8 bandas. BORDES: el grosor y el alfa se desvanecen con un
+// smoothstep en el 16 % externo de cada lado — la onda nunca se
+// corta feo contra el borde del lienzo, se apaga antes de llegar.
+// El color es el degradado dinamico de siempre (fase rodante),
+// fijo en todos los disenos, como pidio el usuario.
+void WaveCanvas::drawOnda(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  struct Capa {
+    size_t ago;
+    double factor;
+    double alfa;
+  };
+  const Capa capas[3] = {{6, 1.55, 0.15}, {3, 1.25, 0.30}, {0, 0.90, 0.95}};
+  const double margen = 4.0;
+  const double util = w - 2 * margen;
+  const double paso = util / (M - 1);
+  for (const auto& capa : capas) {
+    const std::vector<double>* src = &values_;
+    if (capa.ago > 0 && hist_.size() > capa.ago) {
+      src = &hist_[hist_.size() - 1 - capa.ago];
+    }
+    const auto sm = muestras(*src);
+    for (int i = 0; i < M; ++i) {
+      const double t = static_cast<double>(i) / (M - 1);
+      const double x = margen + t * util;
+      const double borde = std::min(t, 1.0 - t) / 0.16;
+      const double ec = std::clamp(borde, 0.0, 1.0);
+      const double taper = ec * ec * (3.0 - 2.0 * ec);
+      const double v = std::clamp(sm[i], 0.0, 1.0);
+      const double th = (1.2 + v * (h - 9.0)) * capa.factor * (0.10 + 0.90 * taper);
+      double r, g, b;
+      if (!gradientColor(t, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      cr->set_source_rgba(r, g, b, capa.alfa * (0.20 + 0.80 * taper));
+      cr->rectangle(x - paso / 2 - 0.4, mid - th / 2, paso + 0.8, th);
+      cr->fill();
+    }
+  }
+}
+
+
+// ── Estela larga (musica; variante T3 de la onda, 2026-11-09) ─
+// La misma silueta de la onda del dictado (drawOnda no se toca:
+// es el diseno cerrado del micro), pero con CINCO capas de
+// historia en vez de tres: la estela se alarga y se suaviza
+// (atrasos 10/7/4/2/0, grosores crecientes hacia atras, alfas
+// decrecientes). Solo para la musica, clase «estela».
+void WaveCanvas::drawEstela(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  struct Capa {
+    size_t ago;
+    double factor;
+    double alfa;
+  };
+  const Capa capas[5] = {{10, 1.85, 0.08}, {7, 1.66, 0.13}, {4, 1.45, 0.20}, {2, 1.20, 0.33}, {0, 0.92, 0.95}};
+  const double margen = 4.0;
+  const double util = w - 2 * margen;
+  const double paso = util / (M - 1);
+  for (const auto& capa : capas) {
+    const std::vector<double>* src = &values_;
+    if (capa.ago > 0 && hist_.size() > capa.ago) {
+      src = &hist_[hist_.size() - 1 - capa.ago];
+    }
+    const auto sm = muestras(*src);
+    for (int i = 0; i < M; ++i) {
+      const double t = static_cast<double>(i) / (M - 1);
+      const double x = margen + t * util;
+      const double borde = std::min(t, 1.0 - t) / 0.16;
+      const double ec = std::clamp(borde, 0.0, 1.0);
+      const double taper = ec * ec * (3.0 - 2.0 * ec);
+      const double v = std::clamp(sm[i], 0.0, 1.0);
+      const double th = (1.2 + v * (h - 9.0)) * capa.factor * (0.10 + 0.90 * taper);
+      double r, g, b;
+      if (!gradientColor(t, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      cr->set_source_rgba(r, g, b, capa.alfa * (0.20 + 0.80 * taper));
+      cr->rectangle(x - paso / 2 - 0.4, mid - th / 2, paso + 0.8, th);
+      cr->fill();
+    }
+  }
+}
+
+
+// ── Cuerdas (musica; eleccion N7 suya, 2026-11-09) ─────────────
+// Cinco cuerdas a todo lo ancho que vibran con la musica: cada
+// una ondula como una cuerda de guitarra, con una frecuencia y
+// una fase propias que ruedan despacio (ninguna se queda quieta),
+// y la amplitud de la ondulacion en cada punto la manda el nivel
+// de esa zona del espectro (valores interpolados disp_). El color
+// es el degradado dinamico de siempre, por tramo. Una sola pasada
+// de trazos por fotograma: diseno pensado para ir fluido.
+void WaveCanvas::drawCuerdas(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const std::vector<double>& vals = disp_.size() == values_.size() ? disp_ : values_;
+  const size_t n = vals.size();
+  if (n == 0) {
+    return;
+  }
+  auto nivel_en = [&vals, n](double x) {
+    const double pos = std::clamp(x, 0.0, 1.0) * static_cast<double>(n - 1);
+    const size_t j = static_cast<size_t>(pos);
+    double f = pos - static_cast<double>(j);
+    f = (1.0 - std::cos(f * M_PI)) / 2.0;
+    const double a = vals[j];
+    const double b = vals[std::min(n - 1, j + 1)];
+    return std::clamp(a * (1.0 - f) + b * f, 0.0, 1.0);
+  };
+  const double bases[5] = {0.16, 0.33, 0.50, 0.67, 0.84};
+  const int SEG = 22;
+  cr->set_line_cap(Cairo::LINE_CAP_ROUND);
+  cr->set_line_width(1.3);
+  for (int k = 0; k < 5; ++k) {
+    const double yb = h * bases[k];
+    const double ondas = 2.0 + 0.55 * k;
+    const double fase = tick_ * (0.045 + 0.011 * k) + k * 1.7;
+    double px = 0.0;
+    double py = yb + std::sin(fase) * (0.35 + nivel_en(0.0) * 3.1);
+    for (int s = 1; s <= SEG; ++s) {
+      const double x = static_cast<double>(s) / SEG;
+      const double v = nivel_en(x);
+      const double y = yb + std::sin(x * M_PI * ondas + fase) * (0.35 + v * 3.1);
+      double r, g, b;
+      if (!gradientColor(x, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      cr->set_source_rgba(r, g, b, 0.92);
+      cr->move_to(px, py);
+      cr->line_to(x * w, y);
+      cr->stroke();
+      px = x * w;
+      py = y;
+    }
+  }
+}
+
+
+// ── ADN grueso (musica; eleccion Q10 suya, 2026-11-09) ────────
+// Dos cintas gruesas entrelazadas a todo lo ancho: el centro de
+// cada una cruza el eje dos veces por lienzo con un vaiven lento
+// propio, y su grosor lo manda el nivel local interpolado. El
+// relleno es un patron lineal de Cairo muestreado del degradado
+// dinamico (25 paradas por fotograma, con la cache de paradas de
+// la nota 48 detras): el color rueda como siempre sin pintar por
+// tramos. Dos rellenos por fotograma: lo mas barato de la casa.
+void WaveCanvas::drawAdn(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const std::vector<double>& vals = disp_.size() == values_.size() ? disp_ : values_;
+  const size_t n = vals.size();
+  if (n == 0) {
+    return;
+  }
+  auto nivel_en = [&vals, n](double x) {
+    const double pos = std::clamp(x, 0.0, 1.0) * static_cast<double>(n - 1);
+    const size_t j = static_cast<size_t>(pos);
+    double f = pos - static_cast<double>(j);
+    f = (1.0 - std::cos(f * M_PI)) / 2.0;
+    const double a = vals[j];
+    const double b = vals[std::min(n - 1, j + 1)];
+    return std::clamp(a * (1.0 - f) + b * f, 0.0, 1.0);
+  };
+  auto pat = Cairo::LinearGradient::create(0, 0, w, 0);
+  const int PARADAS = 24;
+  for (int k = 0; k <= PARADAS; ++k) {
+    double r, g, b;
+    if (!gradientColor(static_cast<double>(k) / PARADAS, r, g, b)) {
+      r = g = b = 1.0;
+    }
+    pat->add_color_stop_rgba(static_cast<double>(k) / PARADAS, r, g, b, 0.95);
+  }
+  cr->set_source(pat);
+  const int MUESTRAS = 64;
+  for (int cinta = 0; cinta < 2; ++cinta) {
+    const double fase = tick_ * 0.03 + cinta * M_PI;
+    for (int s = 0; s <= MUESTRAS; ++s) {
+      const double x = static_cast<double>(s) / MUESTRAS;
+      const double v = nivel_en(x);
+      const double yc = h / 2 + std::sin(x * M_PI * 4.0 + fase) * (1.4 + v * 3.4);
+      const double gr = (1.3 + v * 3.0) / 2;
+      if (s == 0) {
+        cr->move_to(x * w, yc - gr);
+      } else {
+        cr->line_to(x * w, yc - gr);
+      }
+    }
+    for (int s = MUESTRAS; s >= 0; --s) {
+      const double x = static_cast<double>(s) / MUESTRAS;
+      const double v = nivel_en(x);
+      const double yc = h / 2 + std::sin(x * M_PI * 4.0 + fase) * (1.4 + v * 3.4);
+      const double gr = (1.3 + v * 3.0) / 2;
+      cr->line_to(x * w, yc + gr);
+    }
+    cr->close_path();
+    cr->fill();
+  }
+}
+
+
+// ── Nivel local interpolado (compartido por cuerdas/adn) ─────
+static double waveNivelEn(const std::vector<double>& vals, double x) {
+  const size_t n = vals.size();
+  const double pos = std::clamp(x, 0.0, 1.0) * static_cast<double>(n - 1);
+  const size_t j = static_cast<size_t>(pos);
+  double f = pos - static_cast<double>(j);
+  f = (1.0 - std::cos(f * M_PI)) / 2.0;
+  const double a = vals[j];
+  const double b = vals[std::min(n - 1, j + 1)];
+  return std::clamp(a * (1.0 - f) + b * f, 0.0, 1.0);
+}
+
+// ── Panal (musica; eleccion R12 suya, 2026-11-09) ─────────────
+// Rejilla de hexagonos de punta arriba que respira con el nivel
+// de su columna: cada celda se escala con el espectro local y un
+// brillo lento que recorre las columnas. ~24 poligonos por
+// fotograma, color del degradado dinamico por celda.
+void WaveCanvas::drawPanal(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const std::vector<double>& vals = disp_.size() == values_.size() ? disp_ : values_;
+  if (vals.empty()) {
+    return;
+  }
+  const double r = 5.8;
+  const double dx = std::sqrt(3.0) * r * 1.04;
+  const double dy = 1.5 * r;
+  int col = 0;
+  for (double cx = r * 0.4; cx < w + r; cx += dx, ++col) {
+    const double v = waveNivelEn(vals, cx / w);
+    const double brillo = 0.92 + 0.08 * std::sin(tick_ * 0.05 + col * 0.9);
+    double rr = r * (0.40 + v * 0.58) * brillo;
+    double r1, g1, b1;
+    if (!gradientColor(std::clamp(cx / w, 0.0, 1.0), r1, g1, b1)) {
+      r1 = g1 = b1 = 1.0;
+    }
+    cr->set_source_rgba(r1, g1, b1, 0.92);
+    for (int fila = 0; fila < 3; ++fila) {
+      const double cy = r + fila * dy + (col % 2 ? dy / 2 : 0.0);
+      if (cy - r > h) {
+        continue;
+      }
+      for (int k = 0; k < 6; ++k) {
+        const double ang = M_PI / 3 * k - M_PI / 2;
+        const double px = cx + std::cos(ang) * rr;
+        const double py = cy + std::sin(ang) * rr;
+        if (k == 0) {
+          cr->move_to(px, py);
+        } else {
+          cr->line_to(px, py);
+        }
+      }
+      cr->close_path();
+      cr->fill();
+    }
+  }
+}
+
+// ── Hexagonos (musica; eleccion R7 suya, 2026-11-09) ──────────
+// Un hexagono por banda, centrado, cuyo radio manda el nivel
+// interpolado; dentro, otro hexagono al 55 % mas tenue como
+// faceta. Color del degradado dinamico en la posicion de la
+// banda.
+void WaveCanvas::drawHexagonos(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const std::vector<double>& vals = disp_.size() == values_.size() ? disp_ : values_;
+  const size_t n = vals.size();
+  if (n == 0) {
+    return;
+  }
+  for (size_t i = 0; i < n; ++i) {
+    const double t = (static_cast<double>(i) + 0.5) / static_cast<double>(n);
+    const double cx = t * w;
+    const double cy = h / 2;
+    const double v = std::clamp(vals[i], 0.0, 1.0);
+    const double rr = 2.2 + v * 3.6;
+    double r1, g1, b1;
+    if (!gradientColor(t, r1, g1, b1)) {
+      r1 = g1 = b1 = 1.0;
+    }
+    for (int capa = 0; capa < 2; ++capa) {
+      const double rad = rr * (capa == 0 ? 1.0 : 0.55);
+      cr->set_source_rgba(r1, g1, b1, capa == 0 ? 0.95 : 0.5);
+      for (int k = 0; k < 6; ++k) {
+        const double ang = M_PI / 3 * k - M_PI / 2;
+        const double px = cx + std::cos(ang) * rad;
+        const double py = cy + std::sin(ang) * rad;
+        if (k == 0) {
+          cr->move_to(px, py);
+        } else {
+          cr->line_to(px, py);
+        }
+      }
+      cr->close_path();
+      cr->fill();
+    }
+  }
+}
+
+
+// ── Oleaje (musica; eleccion S1 suya, 2026-11-09) ─────────────
+// Tres mareas llenas superpuestas, de atras hacia adelante: cada
+// capa es una silueta suave cuya altura manda el nivel
+// interpolado, con una deriva senoidal lenta propia (las capas
+// se cruzan entre si), y cada capa de adelante es mas baja y mas
+// opaca. Relleno con el patron lineal del degradado dinamico,
+// como el ADN: tres rellenos por fotograma.
+void WaveCanvas::drawOleaje(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const std::vector<double>& vals = disp_.size() == values_.size() ? disp_ : values_;
+  if (vals.empty()) {
+    return;
+  }
+  struct Capa {
+    double amp;
+    double alfa;
+    double desp;
+    double vel;
+  };
+  const Capa capas[3] = {{6.5, 0.35, 0.0, 0.020}, {5.2, 0.55, 2.2, 0.027}, {4.0, 0.85, 4.4, 0.034}};
+  const int MUESTRAS = 80;
+  for (const auto& capa : capas) {
+    auto pat = Cairo::LinearGradient::create(0, 0, w, 0);
+    const int PARADAS = 24;
+    for (int k = 0; k <= PARADAS; ++k) {
+      double r, g, b;
+      if (!gradientColor(static_cast<double>(k) / PARADAS, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      pat->add_color_stop_rgba(static_cast<double>(k) / PARADAS, r, g, b, capa.alfa);
+    }
+    cr->set_source(pat);
+    const double fase = tick_ * capa.vel;
+    const double base = h * 0.60 + capa.desp;
+    for (int s = 0; s <= MUESTRAS; ++s) {
+      const double x = static_cast<double>(s) / MUESTRAS;
+      const double v = waveNivelEn(vals, x);
+      const double y = base - v * capa.amp + std::sin(x * M_PI * 3.0 + fase) * 1.3;
+      if (s == 0) {
+        cr->move_to(0, y);
+      } else {
+        cr->line_to(x * w, y);
+      }
+    }
+    cr->line_to(w, h);
+    cr->line_to(0, h);
+    cr->close_path();
+    cr->fill();
+  }
+}
+
+
+// ── Chispas que saltan (dictado; opcion P8, a prueba 2026-11-08) ─
+// Por cada banda, tres particulas con saltos pseudoaleatorios
+// deterministas (hash del indice y del tick: saltan unas 10 veces
+// por segundo) cuya dispersion y tamano crecen con el nivel. El
+// color es el degradado dinamico de siempre, fijo en todo diseno.
+void WaveCanvas::drawChispas(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  const size_t n = values_.size();
+  if (n == 0) {
+    return;
+  }
+  const double inset = 11.0;
+  const double span = w - 2 * inset;
+  auto hash01 = [](int seed) {
+    unsigned x = static_cast<unsigned>(seed) * 2654435761u;
+    x ^= x >> 15;
+    x *= 2246822519u;
+    x ^= x >> 13;
+    return static_cast<double>(x & 0xFFFFFFu) / static_cast<double>(0x1000000u);
+  };
+  const int salto = tick_ / 4;  // tick de 25 ms: mismo ritmo de saltos (~10/s)
+  for (size_t i = 0; i < n; ++i) {
+    const double v = std::clamp(values_[i], 0.0, 1.0);
+    const double t = n > 1 ? static_cast<double>(i) / static_cast<double>(n - 1) : 0.5;
+    const double cx = inset + span * t;
+    double r, g, b;
+    if (!gradientColor(t, r, g, b)) {
+      r = g = b = 1.0;
+    }
+    // Punto de ancla tenue en el centro de la banda.
+    cr->set_source_rgba(r, g, b, 0.35);
+    cr->arc(cx, mid, 1.3, 0, 2 * M_PI);
+    cr->fill();
+    for (int k = 0; k < 3; ++k) {
+      const int seed = static_cast<int>(i) * 31 + k * 57 + salto * 7;
+      const double dx = (hash01(seed) - 0.5) * (8.0 + v * 20.0);
+      double dy = (hash01(seed + 1000) - 0.5) * (4.0 + v * 20.0);
+      dy = std::clamp(dy, -(mid - 2.5), mid - 2.5);
+      const double pr = 1.1 + hash01(seed + 2000) * (0.8 + v * 1.9);
+      cr->set_source_rgba(r, g, b, 0.25 + 0.70 * v);
+      cr->arc(cx + dx, mid + dy, pr, 0, 2 * M_PI);
+      cr->fill();
+    }
+  }
+}
+
+
+// ── Simbolos de idiomas (transcribiendo; R1, eleccion suya) ──
+// Animacion de carga: sin sonido no hay nivel; cada columna
+// muestra un glifo de un alfabeto distinto que cambia cada
+// ~0,5 s (hash de la columna y del tick, escalonado), en
+// negrita y con el degradado dinamico de siempre (fijo).
+// Pango resuelve la fuente de cada escritura por fallback.
+void WaveCanvas::drawSimbolos(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const size_t n = values_.size();
+  if (n == 0) {
+    return;
+  }
+  static const char* GLIFOS[] = {
+      "あ", "ア", "イ", "ウ", "エ", "語", "文", "字", "中", "韓",
+      "한", "글", "자", "Ω", "α", "λ", "Ψ", "Ж", "Д", "Я",
+      "Ф", "ع", "ش", "س", "م", "א", "ש", "ל", "Հ", "Ո",
+      "ა", "ქ", "অ", "ক", "ก",
+  };
+  const int total = static_cast<int>(sizeof(GLIFOS) / sizeof(GLIFOS[0]));
+  const double inset = 11.0;
+  const double span = w - 2 * inset;
+  const double mid = h / 2.0;
+  auto hash01 = [](int seed) {
+    unsigned x = static_cast<unsigned>(seed) * 2654435761u;
+    x ^= x >> 15;
+    x *= 2246822519u;
+    x ^= x >> 13;
+    return static_cast<double>(x & 0xFFFFFFu) / static_cast<double>(0x1000000u);
+  };
+  const int paso = tick_ / 20;  // tick de 25 ms: mismo paso de 0,5 s
+  for (size_t i = 0; i < n; ++i) {
+    const double t = n > 1 ? static_cast<double>(i) / static_cast<double>(n - 1) : 0.5;
+    // Ritmo PROPIO por columna (correccion suya: no todos a la
+    // vez): cada columna cambia cada 1-4 pasos (0,5-2 s) con su
+    // fase, asi los cambios se escalonan y se aprecian.
+    const int periodo = 1 + static_cast<int>(hash01(static_cast<int>(i) * 101) * 4.0);
+    const int fase = static_cast<int>(hash01(static_cast<int>(i) * 202) * 8.0);
+    const int ciclo = (paso + fase) / periodo;
+    const int semilla = static_cast<int>(i) * 31 + ciclo * 17;
+    const int gi = static_cast<int>(hash01(semilla) * total) % total;
+    // Tamano y posicion tambien varian por glifo (11-16,5 px;
+    // jitter de +-2,5 px en x y +-3 px en y), guardando la
+    // distancia minima que dan las columnas fijas.
+    const double tam = 11.0 + hash01(static_cast<int>(i) * 303 + ciclo) * 5.5;
+    const double jx = (hash01(static_cast<int>(i) * 404 + ciclo) - 0.5) * 5.0;
+    const double jy = (hash01(static_cast<int>(i) * 505 + ciclo) - 0.5) * 6.0;
+    Pango::FontDescription fd("Sans Bold");
+    fd.set_absolute_size(tam * 1024);  // 1024 = PANGO_SCALE
+    double r, g, b;
+    if (!gradientColor(t, r, g, b)) {
+      r = g = b = 1.0;
+    }
+    const double alfa = 0.60 + 0.40 * hash01(static_cast<int>(i) * 606 + ciclo);
+    auto layout = create_pango_layout(GLIFOS[gi]);
+    layout->set_font_description(fd);
+    Pango::Rectangle ink, logical;
+    layout->get_pixel_extents(ink, logical);
+    cr->set_source_rgba(r, g, b, alfa);
+    cr->move_to(inset + span * t + jx - ink.get_x() - ink.get_width() / 2.0,
+                mid + jy - ink.get_y() - ink.get_height() / 2.0);
+    layout->show_in_cairo_context(cr);
+  }
+}
+
+// ── Wave ───────────────────────────────────────────────────────────
+// The worker model is the ring module's: signal-only waits,
+// interval polls, and with neither, the exec is a continuous
+// stream of JSON lines (the cava converter at 30 fps).
+
+Wave::Wave(const std::string& name, const std::string& id, const Json::Value& config,
+           const std::string& output_name)
+    : AModule(config, "wave-" + name, id, true, true), name_(name), output_name_(output_name) {
+  full_width_ = config["width"].isNumeric() ? config["width"].asDouble() : 86.0;
+  height_ = config["height"].isNumeric() ? config["height"].asDouble() : 26.0;
+  // Start collapsed: the width only opens (animated) when sound
+  // actually arrives, so the bar boots with the center at rest.
+  canvas_.set_size_request(0, static_cast<int>(height_));
+  if (config["color"].isString()) {
+    canvas_.setColor(config["color"].asString());
+  }
+  if (config["gradient"].isArray()) {
+    std::vector<std::string> stops;
+    for (auto const& s : config["gradient"]) {
+      if (s.isString()) {
+        stops.push_back(s.asString());
+      }
+    }
+    if (!stops.empty()) {
+      canvas_.setGradient(stops);
+    }
+  }
+
+  canvas_.setInnerRight(name_.find("left") != std::string::npos);
+  wrap_.set_name("wave-" + name);
+  wrap_.get_style_context()->add_class(MODULE_CLASS);
+  wrap_.set_halign(Gtk::ALIGN_CENTER);
+  wrap_.set_valign(Gtk::ALIGN_CENTER);
+  wrap_.add(canvas_);
+  event_box_.add(wrap_);
+
+  canvas_.signal_style_updated().connect([this]() { canvas_.queue_draw(); });
+
+  if (config["interval"].isNumeric()) {
+    interval_ = std::chrono::seconds(static_cast<long>(config["interval"].asDouble()));
+  }
+
+  if (!config["signal"].empty() && config["interval"].empty()) {
+    waitingWorker();
+  } else if (interval_.count() > 0) {
+    delayWorker();
+  } else if (config["exec"].isString()) {
+    continuousWorker();
+  } else {
+    dp.emit();
+  }
+}
+
+Wave::~Wave() {
+  restart_connection_.disconnect();
+  hold_conn_.disconnect();
+  anim_conn_.disconnect();
+  if (continuous_stream_) {
+    continuous_stream_->stop();
+  }
+}
+
+// ── Fluid visibility ───────────────────────────────────────────────
+// Silence does not hide the module right away: it HOLDs its width
+// for 5 s (brief pauses are invisible to the layout), then the
+// width animates to 0. Sound cancels any pending collapse and
+// animates the width back up. The neighbours of modules-center
+// slide with the animation instead of snapping (user's spec).
+
+void Wave::onSoundFrame() {
+  hold_conn_.disconnect();
+  if (vis_ == Vis::Gone || vis_ == Vis::Collapsing || vis_ == Vis::Holding) {
+    vis_ = Vis::Expanding;
+    target_width_ = full_width_;
+    startAnim();
+  }
+}
+
+void Wave::onSilenceFrame() {
+  if (vis_ == Vis::Shown || vis_ == Vis::Expanding) {
+    vis_ = Vis::Holding;
+    hold_conn_.disconnect();
+    hold_conn_ = Glib::signal_timeout().connect(
+        [this]() {
+          if (vis_ == Vis::Holding) {
+            vis_ = Vis::Collapsing;
+            target_width_ = 0.0;
+            startAnim();
+          }
+          return false;
+        },
+        5000);
+  }
+}
+
+void Wave::startAnim() {
+  if (!anim_conn_.connected()) {
+    anim_conn_ = Glib::signal_timeout().connect(sigc::mem_fun(*this, &Wave::animTick), 16);
+  }
+}
+
+bool Wave::animTick() {
+  const double diff = target_width_ - shown_width_;
+  if (std::abs(diff) < 0.8) {
+    shown_width_ = target_width_;
+    canvas_.set_size_request(static_cast<int>(shown_width_ + 0.5), static_cast<int>(height_));
+    if (vis_ == Vis::Expanding) {
+      vis_ = Vis::Shown;
+    } else if (vis_ == Vis::Collapsing) {
+      vis_ = Vis::Gone;
+    }
+    return false;
+  }
+  shown_width_ += diff * 0.11;
+  canvas_.set_size_request(static_cast<int>(shown_width_ + 0.5), static_cast<int>(height_));
+  return true;
+}
+
+void Wave::delayWorker() {
+  if (!config_["exec"].isString() && !config_["exec-if"].isString()) {
+    dp.emit();
+    return;
+  }
+
+  thread_ = [this] {
+    for (auto it = this->pid_children_.begin(); it != this->pid_children_.end();) {
+      int status = 0;
+      const auto pid = static_cast<pid_t>(*it);
+      const auto waited = waitpid(pid, &status, WNOHANG);
+      if (waited == 0) {
+        ++it;
+        continue;
+      }
+      if (waited == -1 && errno != ECHILD) {
+        ++it;
+        continue;
+      }
+      it = this->pid_children_.erase(it);
+    }
+
+    bool can_update = true;
+    if (config_["exec-if"].isString()) {
+      output_ = util::command::execNoRead(config_["exec-if"].asString());
+      if (output_.exit_code != 0) {
+        can_update = false;
+        dp.emit();
+      }
+    }
+    if (can_update) {
+      if (config_["exec"].isString()) {
+        output_ = util::command::exec(config_["exec"].asString(), output_name_);
+      }
+      dp.emit();
+    }
+    thread_.sleep_for(interval_);
+  };
+}
+
+void Wave::continuousWorker() {
+  continuous_stream_ = std::make_unique<util::command::LineStream>(
+      output_name_,
+      [this](const std::string& output) {
+        output_ = {.exit_code = 0, .out = output};
+        dp.emit();
+      },
+      [this](int exit_code) { handleContinuousProcessExit(exit_code); });
+  startContinuousProcess(true);
+}
+
+void Wave::startContinuousProcess(bool throw_on_failure) {
+  const auto cmd = config_["exec"].asString();
+
+  try {
+    continuous_stream_->start(cmd);
+  } catch (const Glib::SpawnError& e) {
+    if (throw_on_failure) {
+      throw std::runtime_error("Unable to open " + cmd + ": " + e.what().raw());
+    }
+    output_ = {.exit_code = 1, .out = ""};
+    dp.emit();
+    spdlog::error("Unable to restart {}: {}", name_, e.what().raw());
+    scheduleContinuousRestart();
+  } catch (const std::exception& e) {
+    if (throw_on_failure) {
+      throw;
+    }
+    output_ = {.exit_code = 1, .out = ""};
+    dp.emit();
+    spdlog::error("Unable to restart {}: {}", name_, e.what());
+    scheduleContinuousRestart();
+  }
+}
+
+void Wave::handleContinuousProcessExit(int exit_code) {
+  if (exit_code != 0) {
+    output_ = {.exit_code = exit_code, .out = ""};
+    dp.emit();
+    spdlog::error("{} stopped unexpectedly, is it endless?", name_);
+  }
+
+  scheduleContinuousRestart();
+}
+
+void Wave::scheduleContinuousRestart() {
+  restart_connection_.disconnect();
+  if (!config_["restart-interval"].isNumeric() || config_["restart-interval"].asDouble() <= 0) {
+    return;
+  }
+
+  restart_connection_ = Glib::signal_timeout().connect(
+      [this] {
+        startContinuousProcess(false);
+        return false;
+      },
+      std::max(1U, static_cast<unsigned>(config_["restart-interval"].asDouble() * 1000)));
+}
+
+void Wave::waitingWorker() {
+  thread_ = [this] {
+    bool can_update = true;
+    if (config_["exec-if"].isString()) {
+      output_ = util::command::execNoRead(config_["exec-if"].asString());
+      if (output_.exit_code != 0) {
+        can_update = false;
+        dp.emit();
+      }
+    }
+    if (can_update) {
+      if (config_["exec"].isString()) {
+        output_ = util::command::exec(config_["exec"].asString(), output_name_);
+      }
+      dp.emit();
+    }
+    thread_.sleep();
+  };
+}
+
+void Wave::refresh(int sig) {
+#ifdef SIGRTMIN
+  if (config_["signal"].isInt() && sig == SIGRTMIN + config_["signal"].asInt()) {
+    thread_.wake_up();
+  }
+#endif
+}
+
+void Wave::handleEvent() {
+  if (!config_["exec-on-event"].isBool() || config_["exec-on-event"].asBool()) {
+    thread_.wake_up();
+  }
+}
+
+bool Wave::handleScroll(GdkEventScroll* e) {
+  auto ret = AModule::handleScroll(e);
+  handleEvent();
+  return ret;
+}
+
+bool Wave::handleToggle(GdkEventButton* const& e) {
+  auto ret = AModule::handleToggle(e);
+  handleEvent();
+  return ret;
+}
+
+auto Wave::update() -> void {
+  if ((config_["exec"].isString() || config_["exec-if"].isString()) &&
+      (output_.out.empty() || output_.exit_code != 0)) {
+    event_box_.hide();
+  } else {
+    parseOutputJson();
+
+    bool silence = false;
+    for (auto const& c : class_) {
+      if (c == "hide") {
+        silence = true;
+      }
+    }
+    if (silence) {
+      onSilenceFrame();
+    } else {
+      onSoundFrame();
+    }
+
+    // En silencio el fotograma no trae diseno (solo la clase
+    // "hide"): NO se tocan los modos, para que el lienzo siga
+    // dibujando el diseno vigente y se desvanezca con los
+    // valores a cero, en vez de caer al dibujo por defecto —
+    // los puntos minimos que se veian como vestigio cuando la
+    // onda se ocultaba (observacion suya, 2026-11-09).
+    if (!silence) {
+      bool mic = false;
+      bool chispas = false;
+      bool simbolos = false;
+      bool cuerdas = false;
+      bool adn = false;
+      bool panal = false;
+      bool hexagonos = false;
+      bool oleaje = false;
+      bool estela = false;
+      for (auto const& c : class_) {
+        if (c == "mic") {
+          mic = true;
+        } else if (c == "chispas") {
+          chispas = true;
+        } else if (c == "simbolos") {
+          simbolos = true;
+        } else if (c == "cuerdas") {
+          cuerdas = true;
+        } else if (c == "adn") {
+          adn = true;
+        } else if (c == "panal") {
+          panal = true;
+        } else if (c == "hexagonos") {
+          hexagonos = true;
+        } else if (c == "oleaje") {
+          oleaje = true;
+        } else if (c == "estela") {
+          estela = true;
+        }
+      }
+      canvas_.setOnda(mic);
+      canvas_.setChispas(chispas);
+      canvas_.setSimbolos(simbolos);
+      canvas_.setCuerdas(cuerdas);
+      canvas_.setAdn(adn);
+      canvas_.setPanal(panal);
+      canvas_.setHexagonos(hexagonos);
+      canvas_.setOleaje(oleaje);
+      canvas_.setEstela(estela);
+    }
+    canvas_.setValues(values_);
+    if (tooltipEnabled()) {
+      event_box_.set_tooltip_markup(tooltip_);
+    }
+
+    // The "hide" class reaches the widget only in the Gone state:
+    // while holding or collapsing the module stays fully opaque
+    // and its shrinking width is what the eye follows.
+    auto style = wrap_.get_style_context();
+    for (auto const& c : style->list_classes()) {
+      if (c == MODULE_CLASS) {
+        continue;
+      }
+      style->remove_class(c);
+    }
+    if (vis_ == Vis::Gone) {
+      style->add_class("hide");
+    }
+    event_box_.show();
+  }
+  AModule::update();
+}
+
+void Wave::parseOutputJson() {
+  std::istringstream output(output_.out);
+  std::string line;
+  class_.clear();
+  auto sanitize = [](const std::string& s) -> Glib::ustring {
+    Glib::ustring value = s;
+    if (!value.validate()) {
+      value = value.make_valid();
+    }
+    return value;
+  };
+  while (getline(output, line)) {
+    auto parsed = parser_.parse(line);
+    tooltip_ = sanitize(parsed["tooltip"].asString());
+    if (parsed["class"].isString()) {
+      class_.push_back(parsed["class"].asString());
+    } else if (parsed["class"].isArray()) {
+      for (auto const& c : parsed["class"]) {
+        class_.push_back(c.asString());
+      }
+    }
+    values_.clear();
+    if (parsed["values"].isArray()) {
+      for (auto const& v : parsed["values"]) {
+        if (v.isNumeric()) {
+          values_.push_back(std::clamp(v.asDouble(), 0.0, 1.0));
+        }
+      }
+    }
+    break;
+  }
+}
