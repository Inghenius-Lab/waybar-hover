+// ── Bloques pixel (musica; diseno 3 de la tanda diversa,
+// eleccion suya del 2026-11-11: queda PUESTO en musica) ─────
+// Columnas de cubitos retro que se apilan desde el centro
+// hacia arriba y hacia abajo segun el nivel, con la
+// envolvente de los laterales: en los extremos la pila muere
+// a ras del centro. Color del degradado, aclarado por altura.
+void WaveCanvas::drawPixel(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  // Pixel EN RACIMO (variante 3, eleccion suya 2026-11-11):
+  // las mismas pilas de bloques, pero el color va por TONOS
+  // DISCRETOS que derivan al azar en cada columna (logica de
+  // pixeles, no el degradado con respiracion, que queda para
+  // los demas disenos) y de vez en cuando un bloque GIGANTE
+  // nace EN GRUPO: arrastra a sus vecinos, crece hasta casi
+  // el doble y se sobrepone a los demas, sin deformar la
+  // barra porque todo pasa dentro del lienzo.
+  const double mid = h / 2.0;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  // La regla de los 5 s, restaurada para el pixel
+  // (2026-11-11): el modulo mantiene el ancho 5 s en
+  // silencio antes de colapsar, pero el pixel con los
+  // valores a cero no dibuja NADA, y el efecto parecia
+  // desaparecer al instante (la estela en cambio dejaba
+  // su linea plana visible). Ahora el lienzo guarda el
+  // ultimo fotograma con sonido y lo sigue dibujando
+  // durante la espera, con su deriva y sus gigantes
+  // vivos: la espera se VE, como debe ser.
+  double vmax = 0.0;
+  for (double v : values_) {
+    vmax = std::max(vmax, v);
+  }
+  if (vmax > 0.05) {
+    ultimo_frame_pix_ = values_;
+  }
+  const std::vector<double>& fuente =
+      (vmax <= 0.02 && !ultimo_frame_pix_.empty())
+          ? ultimo_frame_pix_
+          : values_;
+  const auto vs = muestras(fuente);
+  const int COLS = 21;
+  const double paso = w / COLS;
+  const double bw = paso * 0.78;
+  const double bh = (h / 2.0) / 5.4;
+  static thread_local std::mt19937 rng_pix{std::random_device{}()};
+  auto azar01 = [&rng_pix]() {
+    return std::uniform_real_distribution<double>(0.0, 1.0)(rng_pix);
+  };
+  // Tonos discretos: 5 muestras fijas de la rampa de matugen,
+  // refrescadas cada ~20 s (sin respiracion encima).
+  if (tick_ - tonos_pix_tick_ > 600) {
+    tonos_pix_tick_ = tick_;
+    const double pos[5] = {0.06, 0.27, 0.48, 0.69, 0.90};
+    for (int t = 0; t < 5; ++t) {
+      double r, g, b;
+      if (!gradientColor(pos[t], r, g, b)) {
+        r = g = b = 1.0;
+      }
+      tonos_pix_[t] = {r, g, b};
+    }
+  }
+  if (!deriva_pix_ok_) {
+    deriva_pix_ok_ = true;
+    for (int i = 0; i < COLS; ++i) {
+      const double xn = (i + 0.5) / COLS;
+      deriva_pix_[i] = std::clamp(static_cast<int>(xn * 5.0), 0, 4);
+    }
+  }
+  // La deriva: cada columna pasea su tono al azar, paso a paso.
+  for (int i = 0; i < COLS; ++i) {
+    if (azar01() < 0.02) {
+      deriva_pix_[i] =
+          std::clamp(deriva_pix_[i] + (azar01() < 0.5 ? -1 : 1), 0, 4);
+    }
+  }
+  // Gigantes vencidos, fuera.
+  gigantes_pix_.erase(
+      std::remove_if(gigantes_pix_.begin(), gigantes_pix_.end(),
+                     [this](const GigantePix& gp) {
+                       return tick_ - gp.t0 > 13;
+                     }),
+      gigantes_pix_.end());
+  auto buscar_gigante = [this](int col, int k, int sgn) {
+    for (const auto& gp : gigantes_pix_) {
+      if (gp.col == col && gp.k == k && gp.sgn == sgn) {
+        return gp.t0;
+      }
+    }
+    return -1;
+  };
+  struct GiganteVista {
+    double cx, cy, esc;
+  };
+  std::vector<GiganteVista> gigantes;
+  for (int i = 0; i < COLS; ++i) {
+    const double xn = (i + 0.5) / COLS;
+    const double borde = std::min(xn, 1.0 - xn) / 0.16;
+    const double ec = std::clamp(borde, 0.0, 1.0);
+    const double taper = ec * ec * (3.0 - 2.0 * ec);
+    const int idx = std::clamp(static_cast<int>(xn * (M - 1)), 0, M - 1);
+    const double v = std::clamp(vs[idx], 0.0, 1.0) * taper;
+    const int n = static_cast<int>(std::lround(v * 5.0));
+    const double cx = i * paso + paso / 2.0;
+    const auto& tono = tonos_pix_[deriva_pix_[i]];
+    for (int k = 0; k < n; ++k) {
+      const double luz = k * 0.09;
+      const double rr = tono[0] + (1.0 - tono[0]) * luz;
+      const double gg = tono[1] + (1.0 - tono[1]) * luz;
+      const double bb = tono[2] + (1.0 - tono[2]) * luz;
+      for (int sgn = -1; sgn <= 1; sgn += 2) {
+        const int t0 = buscar_gigante(i, k, sgn);
+        double esc = 1.0;
+        if (t0 >= 0) {
+          const double edad = static_cast<double>(tick_ - t0);
+          esc = 1.0 + 0.9 * std::sin(M_PI * edad / 13.0);
+        } else if (azar01() < 0.004) {
+          // Nace el racimo: este bloque y sus vecinos.
+          for (int dk = -1; dk <= 1; ++dk) {
+            for (int ds = -1; ds <= 1; ds += 2) {
+              if (buscar_gigante(i, k + dk, ds) < 0) {
+                gigantes_pix_.push_back({i, k + dk, ds, tick_});
+              }
+            }
+          }
+        }
+        const double cy = mid + sgn * (k + 0.5) * bh;
+        if (esc > 1.05) {
+          gigantes.push_back({cx, cy, esc});
+          continue;
+        }
+        cr->set_source_rgba(rr, gg, bb, 0.95);
+        cr->rectangle(cx - bw / 2.0, cy - bh * 0.41, bw, bh * 0.82);
+        cr->fill();
+      }
+    }
+  }
+  // Los gigantes se pintan AL FINAL: encima de los vecinos.
+  const auto& tg = tonos_pix_[4];
+  const double rr = tg[0] + (1.0 - tg[0]) * 0.45;
+  const double gg = tg[1] + (1.0 - tg[1]) * 0.45;
+  const double bb = tg[2] + (1.0 - tg[2]) * 0.45;
+  cr->set_source_rgba(rr, gg, bb, 0.97);
+  for (const auto& gv : gigantes) {
+    cr->rectangle(gv.cx - bw * gv.esc / 2.0,
+                  gv.cy - bh * 0.41 * gv.esc, bw * gv.esc,
+                  bh * 0.82 * gv.esc);
+    cr->fill();
+  }
+}
