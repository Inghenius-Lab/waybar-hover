+// ── Rayo en capas (musica; diseno 2 de la segunda tanda,
+// eleccion del usuario, 2026-11-11) ─────────────────────────
+// El rayo principal con su estela de ecos: la misma descarga
+// tal como se dibujo hace unos fotogramas, detras, mas gruesa
+// y mas transparente cuanto mas vieja: capas de la descarga.
+// La forma de cada eco sale de hist_ con la fase de entonces,
+// asi que los ecos son el rayo real de ese instante, no una
+// copia desplazada. Bordes y degradado: los de siempre.
+void WaveCanvas::drawCapas(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  auto ruido = [](double semilla) {
+    const double x = std::sin(semilla) * 43758.5453;
+    return (x - std::floor(x)) * 2.0 - 1.0;
+  };
+  const double margen = 4.0;
+  const double util = w - 2 * margen;
+  std::vector<double> xs, ys;
+  auto puntos = [&](const std::vector<double>& src, double fase) {
+    const auto sm = muestras(src);
+    xs.assign(M, 0.0);
+    ys.assign(M, 0.0);
+    for (int i = 0; i < M; ++i) {
+      const double t = static_cast<double>(i) / (M - 1);
+      const double borde = std::min(t, 1.0 - t) / 0.16;
+      const double ec = std::clamp(borde, 0.0, 1.0);
+      const double taper = ec * ec * (3.0 - 2.0 * ec);
+      const double v = std::clamp(sm[i], 0.0, 1.0);
+      const double amp = v * (h * 0.40) * taper;
+      xs[i] = margen + t * util;
+      ys[i] = mid + (std::sin(t * 9.0 - fase * 0.30) * 0.35 +
+                     ruido(i * 127.1 + fase * 311.7) * 0.38 -
+                     std::sin(t * 3.0 + fase * 0.10) * 0.72) * amp;
+    }
+  };
+  auto trazo = [&](double ancho, double alfa, bool nucleo) {
+    cr->set_line_width(ancho);
+    for (int i = 0; i + 1 < M; ++i) {
+      const double t = static_cast<double>(i) / (M - 1);
+      double r, g, b;
+      if (!gradientColor(t, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      if (nucleo) {
+        r += (1.0 - r) * 0.62;
+        g += (1.0 - g) * 0.62;
+        b += (1.0 - b) * 0.62;
+      }
+      cr->set_source_rgba(r, g, b, alfa);
+      cr->move_to(xs[i], ys[i]);
+      cr->line_to(xs[i + 1], ys[i + 1]);
+      cr->stroke();
+    }
+  };
+  cr->set_line_cap(Cairo::LINE_CAP_ROUND);
+  cr->set_line_join(Cairo::LINE_JOIN_ROUND);
+  struct CapaE {
+    size_t ago;
+    double ancho;
+    double alfa;
+  };
+  const CapaE capas[4] = {{7, 4.2, 0.14}, {5, 3.6, 0.22},
+                          {3, 3.0, 0.34}, {2, 2.4, 0.50}};
+  for (const auto& c : capas) {
+    const std::vector<double>* src = &values_;
+    if (c.ago > 0 && hist_.size() > c.ago) {
+      src = &hist_[hist_.size() - 1 - c.ago];
+    }
+    puntos(*src, tick_ - static_cast<double>(c.ago));
+    trazo(c.ancho, c.alfa, false);
+  }
+  puntos(values_, tick_);
+  trazo(1.6, 0.95, false);
+  trazo(0.8, 0.80, true);
+}
+
