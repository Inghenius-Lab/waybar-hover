+// v6 · BUSCANDO: lupa con el globo dentro (el mango sale del hexagono).
+inline void i_buscando(X& x, double t) {
+  const double ox = -4.5 + 1.6 * std::sin(t * .9), oy = -4.5 + 1.3 * std::cos(t * .9), r = 16.4;
+  auto T = [&](const P& p) { return pr(rZ(rX(rY(p, t * .8), -.32), .36), ox, oy); };
+  const double m0 = (r * 1.07 + 1.2) * std::sqrt(0.5);
+  x.lw = 5.4;
+  x.ga = 1;
+  linea(x, C + ox + m0 + 2, C + oy + m0 + 2, C + 27, C + 27);
+  x.ss = x.pal.blanco;
+  x.lw = 1.2;
+  x.ga = .7;
+  linea(x, C + ox + m0 + 3.6, C + oy + m0 + 2, C + 27.2, C + 25.6);
+  x.ss = x.pal.verde;
+  x.ga = .12;
+  circ(x, C + ox, C + oy, r * 1.07, true);
+  std::vector<std::array<P, 24>> L;
+  L.reserve(6);
+  for (int m = 0; m < 3; m++) {
+    std::array<P, 24> o;
+    for (int i = 0; i < 24; i++) {
+      const double a = i * TAU / 24;
+      o[i] = T(rY({r * std::cos(a), r * std::sin(a), 0}, m * PI / 3));
+    }
+    L.push_back(o);
+  }
+  const double lats[3] = {-.7, 0, .7};
+  for (double la : lats) {
+    std::array<P, 24> o;
+    const double rr = r * std::cos(la);
+    for (int i = 0; i < 24; i++) {
+      const double a = i * TAU / 24;
+      o[i] = T({rr * std::cos(a), r * std::sin(la), rr * std::sin(a)});
+    }
+    L.push_back(o);
+  }
+  x.lw = 1.3;
+  for (const auto& o : L) {
+    for (int i = 0; i < 24; i++) {
+      const P& a = o[i];
+      const P& b = o[(i + 1) % 24];
+      x.ga = a[2] + b[2] > 0 ? .95 : (x.chico ? .12 : .2);
+      x.begin();
+      x.mt(a[0], a[1]);
+      x.lt(b[0], b[1]);
+      x.stroke();
+    }
+  }
+  x.ga = 1;
+  x.lw = 2.7;
+  circ(x, C + ox, C + oy, r * 1.07 + .6);
+  x.ss = x.pal.blanco;
+  x.lw = 1.3;
+  x.ga = .8;
+  x.begin();
+  x.arc(C + ox, C + oy, r * .82, PI * 1.08, PI * 1.42);
+  x.stroke();
+  x.ss = x.pal.verde;
+  x.ga = 1;
+}
