+// ── Rayo ramificado (musica; diseno 1 de la segunda tanda,
+// SU eleccion final del 2026-11-11: primero marco el 2 y lo
+// corrigio al 1) ────────────────────────────────────────────
+// Nada de una sola linea: SEIS hebras electricas que bailan
+// una alrededor de la otra (frecuencia y fase propias por
+// hebra), cada una con su GROSOR VIVO: mientras una se
+// engrosa otra se afina (pulsos desfasados). Chispas GRANDES,
+// mas visibles que las del rayo simple. Los extremos caen a
+// un punto en los laterales (taper de siempre) y ninguna
+// chispa nace en la zona muerta de los bordes.
+void WaveCanvas::drawRamificado(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  auto ruido = [](double semilla) {
+    const double x = std::sin(semilla) * 43758.5453;
+    return x - std::floor(x);
+  };
+  const auto vs = muestras(values_);
+  double vmax = 0.0;
+  for (double v : vs) {
+    vmax = std::max(vmax, v);
+  }
+  const double margen = 4.0;
+  const double util = w - 2 * margen;
+  cr->set_line_cap(Cairo::LINE_CAP_ROUND);
+  cr->set_line_join(Cairo::LINE_JOIN_ROUND);
+  for (int k = 0; k < 6; ++k) {
+    const double fasek = k * 1.13;
+    const double pulso = 0.5 + 0.5 * std::sin(tick_ * 0.27 + k * 2.1);
+    const double vcen = std::clamp(vs[M / 2], 0.0, 1.0);
+    const double ancho = std::clamp(0.55 + 1.15 * pulso * (0.40 + vcen), 0.5, 1.8);
+    cr->set_line_width(ancho);
+    const double escala = 0.35 + 0.10 * k;
+    double px = 0.0, py = mid;
+    for (int i = 0; i < M; ++i) {
+      const double t = static_cast<double>(i) / (M - 1);
+      const double borde = std::min(t, 1.0 - t) / 0.16;
+      const double ec = std::clamp(borde, 0.0, 1.0);
+      const double taper = ec * ec * (3.0 - 2.0 * ec);
+      const double v = std::clamp(vs[i], 0.0, 1.0);
+      const double amp = v * (h * 0.36) * taper;
+      const double x = margen + t * util;
+      const double y = mid + (std::sin(t * (5.0 + 0.7 * k) - tick_ + fasek) +
+                              (ruido(i * 91.7 + tick_ * 57.3 + k * 771.7) - 0.5) * 0.20) *
+                                 amp * escala;
+      double r, g, b;
+      if (!gradientColor(t, r, g, b)) {
+        r = g = b = 1.0;
+      }
+      if (k % 2 == 1) {
+        r += (1.0 - r) * 0.18;
+        g += (1.0 - g) * 0.18;
+        b += (1.0 - b) * 0.18;
+      }
+      cr->set_source_rgba(r, g, b, 0.92);
+      if (i > 0) {
+        cr->move_to(px, py);
+        cr->line_to(x, y);
+        cr->stroke();
+      }
+      px = x;
+      py = y;
+    }
+  }
+  // ── Chispas grandes (peticion suya: los puntos mas grandes)
+  spawn_ram_acc_ += vmax * 3.0;
+  while (spawn_ram_acc_ >= 1.0) {
+    spawn_ram_acc_ -= 1.0;
+    if (chispas_ram_.size() >= 100) {
+      break;
+    }
+    const int cand = static_cast<int>(ruido(tick_ * 977.13 + chispas_ram_.size() * 131.7) * (M - 1));
+    const double tc = static_cast<double>(cand) / (M - 1);
+    const double bordec = std::min(tc, 1.0 - tc) / 0.16;
+    if (bordec < 0.5 || vs[cand] <= 0.12) {
+      continue;
+    }
+    ChispaViva c;
+    c.x = margen + tc * util;
+    c.y = mid + (std::sin(tc * 9.0 - tick_ * 0.30) * 0.35 - std::sin(tc * 3.0 + tick_ * 0.10) * 0.72) *
+                    std::clamp(vs[cand], 0.0, 1.0) * (h * 0.40);
+    const double u1 = ruido(tick_ * 331.7 + cand * 17.3);
+    const double u2 = ruido(tick_ * 771.3 + cand * 29.9);
+    const double u3 = ruido(tick_ * 171.9 + cand * 43.1);
+    c.vx = (u1 - 0.5) * 1.1;
+    c.vy = -0.30 - u2 * 0.85;
+    c.vida = 8 + static_cast<int>(u3 * 6.99);
+    c.vida0 = c.vida;
+    double r, g, b;
+    if (!gradientColor(tc, r, g, b)) {
+      r = g = b = 1.0;
+    }
+    c.rgb = {r, g, b};
+    chispas_ram_.push_back(c);
+  }
+  std::vector<ChispaViva> vivas;
+  vivas.reserve(chispas_ram_.size());
+  for (auto& c : chispas_ram_) {
+    c.x += c.vx;
+    c.y += c.vy;
+    c.vy += 0.05;
+    c.vida -= 1;
+    if (c.vida <= 0 || c.x < 0 || c.x > w || c.y < -4 || c.y > h + 4) {
+      continue;
+    }
+    vivas.push_back(c);
+    const double f = static_cast<double>(c.vida) / c.vida0;
+    cr->set_source_rgba(c.rgb[0], c.rgb[1], c.rgb[2], 0.30 + 0.65 * f);
+    cr->arc(c.x, c.y, 0.80 + (c.vida0 - 8) * 0.11, 0, 2 * M_PI);
+    cr->fill();
+  }
+  chispas_ram_.swap(vivas);
+}
