+// ── v6: EL MOTIVO SOBRESALE DEL HEXAGONO ──
+// En los iconos de actividad el hexagono pasa a ser la base (radio RM, mas
+// pequeno que el del logo) y el motivo se dibuja mas grande, rebasandolo.
+// Donde el motivo cruza el contorno, el hexagono se interrumpe (un pequeno
+// corte alrededor del trazo) para que se lea por delante. Todo sigue siendo
+// lineas, arcos y poligonos:
+// 1) el motivo se pinta a traves de la pluma (X::rec), que ademas APUNTA los
+//    trazos fuertes (alfa >= .4) y las zonas opacas (tapa);
+// 2) marco() pinta al final el hexagono troceado en tramos cortos,
+//    saltandose los que caen bajo un trazo o una tapa.
+constexpr double RM = 25.0, HALO = 2.3;
+// Iconos ya existentes: [escala, dx, dy, factor de grosor, casco = el
+// hexagono se corta bajo toda la silueta]. Los nuevos (v6) no estan: usan [1,0,0,1].
+struct Sobre {
+  double k, dx, dy, gw;
+  bool casco = false;
+};
+inline const Sobre& sobre(const std::string& id) {
+  static const Sobre DEF{1, 0, 0, 1, false};
+  static const std::map<std::string, Sobre> T = {
+      {"pensando", {1.7, 0, 1.5, .74, false}}, {"cerebro", {1.46, 0, 1.5, .8, true}},
+      {"ejecutando", {1.66, 0, 0, .76, true}}, {"investigando", {1.5, 0, 0, .84, false}},
+      {"esfera", {1.45, 0, 0, .84, false}},    {"leyendo", {1.8, 0, .5, .68, true}},
+      {"editando", {1.4, -3, -1, .9, false}},  {"creando", {1.4, 1, -1, .86, true}},
+      {"creando-2", {1.26, -3.5, 0, .95, false}}, {"error", {1.66, 0, -2.4, .76, true}},
+      {"listo", {1.78, 0, 0, .72, false}},     {"buscando", {1, 0, 0, 1, true}},
+  };
+  const auto it = T.find(id);
+  return it == T.end() ? DEF : it->second;
+}
+
+inline std::vector<std::array<double, 2>> casco(std::vector<std::array<double, 2>> P) {
+  std::vector<std::array<double, 2>> p = P;
+  std::sort(p.begin(), p.end(), [](const std::array<double, 2>& a, const std::array<double, 2>& b) {
+    return a[0] < b[0] || (a[0] == b[0] && a[1] < b[1]);
+  });
+  auto cr = [](const std::array<double, 2>& o, const std::array<double, 2>& a, const std::array<double, 2>& b) {
+    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
+  };
+  std::vector<std::array<double, 2>> h;
+  for (const auto& q : p) {
+    while (h.size() >= 2 && cr(h[h.size() - 2], h[h.size() - 1], q) <= 0) h.pop_back();
+    h.push_back(q);
+  }
+  const size_t n = h.size() + 1;
+  for (int i = static_cast<int>(p.size()) - 2; i >= 0; i--) {
+    const auto& q = p[i];
+    while (h.size() >= n && cr(h[h.size() - 2], h[h.size() - 1], q) <= 0) h.pop_back();
+    h.push_back(q);
+  }
+  h.pop_back();
+  return h;
+}
+
+// Hexagono troceado (radio RM): se pinta al final del motivo, saltandose
+// los tramos que caen bajo un trazo fuerte o una zona opaca.
+inline void marco(X& x, const Col& col, bool modoCasco) {
+  std::vector<std::vector<X::P2>> tapas = x.tapas;
+  if (modoCasco && x.pts.size() >= 3) {
+    auto h = casco(x.pts);
+    if (h.size() >= 3) tapas.push_back(h);
+  }
+  auto fuera = [&](double px, double py) -> bool {
+    for (const auto& s : x.segs) {
+      const double ex = s[2] - s[0], ey = s[3] - s[1], l2 = ex * ex + ey * ey;
+      double u = 0;
+      if (l2 > 1e-9) {
+        u = ((px - s[0]) * ex + (py - s[1]) * ey) / l2;
+        u = u < 0 ? 0 : (u > 1 ? 1 : u);
+      }
+      if (std::hypot(px - s[0] - u * ex, py - s[1] - u * ey) < s[4] + HALO) return false;
+    }
+    for (const auto& h : tapas) {
+      double d = -1e9;
+      const size_t n = h.size();
+      for (size_t i = 0; i < n; i++) {
+        const auto& a = h[i];
+        const auto& b = h[(i + 1) % n];
+        const double ex = b[0] - a[0], ey = b[1] - a[1];
+        const double l = std::hypot(ex, ey);
+        d = std::max(d, ((px - a[0]) * ey - (py - a[1]) * ex) / (l > 0 ? l : 1.0));
+      }
+      if (d < HALO) return false;
+    }
+    return true;
+  };
+  x.ss = col;
+  x.lw = 3;
+  x.ga = 1;
+  const int N = 22;
+  bool abierto = false;
+  for (int i = 0; i < 6; i++) {
+    const double a0 = -PI / 2 + i * TAU / 6, a1 = a0 + TAU / 6;
+    const double x0 = C + RM * std::cos(a0), y0 = C + RM * std::sin(a0);
+    const double x1 = C + RM * std::cos(a1), y1 = C + RM * std::sin(a1);
+    for (int j = 0; j < N; j++) {
+      const double ax = mez(x0, x1, j / (double)N), ay = mez(y0, y1, j / (double)N);
+      const double bx = mez(x0, x1, (j + 1) / (double)N), by = mez(y0, y1, (j + 1) / (double)N);
+      if (fuera((ax + bx) / 2, (ay + by) / 2)) {
+        if (!abierto) {
+          x.begin();
+          x.mt(ax, ay);
+          abierto = true;
+        }
+        x.lt(bx, by);
+      } else if (abierto) {
+        x.stroke();
+        abierto = false;
+      }
+    }
+  }
+  if (abierto) x.stroke();
+}
+
+// «Volumen» de quien habla, 0..1.
+inline double voz(double t) {
+  return std::min(1.0, .12 + std::abs(std::sin(t * 4.3)) * (.62 + .38 * std::sin(t * 1.9 + .7)));
+}
+// Polilinea con alfa propio (sin moveTo inicial, como en JS).
+inline void tira(X& x, const std::vector<P>& P, double al, bool cerrar = false) {
+  if (!(al >= .02) || P.size() < 2) return;
+  x.ga = std::min(1.0, al);
+  x.begin();
+  for (const auto& p : P) x.lt(p[0], p[1]);
+  if (cerrar) x.close();
+  x.stroke();
+}
+// Zona opaca: el hexagono no se ve a traves (solo con la pluma activa).
+inline void tapar(X& x, const std::vector<P>& P) {
+  if (x.rec) x.tapa(P);
+}
+
+// Caja 3D (centro c, semilados h) pasada por T: caras vistas rellenas,
+// aristas vistas fuertes, ocultas tenues.
+inline const std::array<P, 8>& cajaV() {
+  static const std::array<P, 8> V = [] {
+    std::array<P, 8> v;
+    int i = 0;
+    for (double a : {1.0, -1.0})
+      for (double b : {1.0, -1.0})
+        for (double c : {1.0, -1.0}) v[i++] = {a, b, c};
+    return v;
+  }();
+  return V;
+}
+inline const std::array<std::array<int, 4>, 6>& cajaC() {
+  static const std::array<std::array<int, 4>, 6> C = {
+      {{0, 1, 3, 2}, {4, 6, 7, 5}, {0, 4, 5, 1}, {2, 3, 7, 6}, {0, 2, 6, 4}, {1, 5, 7, 3}}};
+  return C;
+}
+inline const std::array<int, 6>& cajaO() {
+  static const std::array<int, 6> O = [] {
+    std::array<int, 6> o;
+    const auto& V = cajaV();
+    const auto& C = cajaC();
+    for (int n = 0; n < 6; n++) {
+      const auto& f = C[n];
+      const auto& a = V[f[0]];
+      const auto& b = V[f[1]];
+      const auto& c = V[f[2]];
+      const double e[3] = {b[0] - a[0], b[1] - a[1], b[2] - a[2]};
+      const double g[3] = {c[0] - b[0], c[1] - b[1], c[2] - b[2]};
+      const double nn[3] = {e[1] * g[2] - e[2] * g[1], e[2] * g[0] - e[0] * g[2], e[0] * g[1] - e[1] * g[0]};
+      double m[3] = {0, 0, 0};
+      for (int k = 0; k < 3; k++) {
+        double s = 0;
+        for (int idx : f) s += V[idx][k];
+        m[k] = s;
+      }
+      o[n] = nn[0] * m[0] + nn[1] * m[1] + nn[2] * m[2] > 0 ? 1 : -1;
+    }
+    return o;
+  }();
+  return O;
+}
+inline void caja(X& x, const P& c, const P& h, const Tr& T, double w, double alOculta, double alCara) {
+  const auto& V = cajaV();
+  const auto& CC = cajaC();
+  const auto& OO = cajaO();
+  std::vector<P> Pv;
+  Pv.reserve(8);
+  for (const auto& s : V) Pv.push_back(T({c[0] + s[0] * h[0], c[1] + s[1] * h[1], c[2] + s[2] * h[2]}));
+  std::array<bool, 6> vis{};
+  std::map<int, int> cuenta;  // claves enteras: el for..in de JS las recorre en orden ascendente
+  for (int n = 0; n < 6; n++) {
+    const auto& f = CC[n];
+    double ar = 0;
+    for (int i = 0; i < 4; i++) {
+      const P& a = Pv[f[i]];
+      const P& b = Pv[f[(i + 1) % 4]];
+      ar += a[0] * b[1] - b[0] * a[1];
+    }
+    const bool v = ar * OO[n] > 0;
+    vis[n] = v;
+    for (int i = 0; i < 4; i++) {
+      const int a = f[i], b = f[(i + 1) % 4];
+      const int k = std::min(a, b) * 8 + std::max(a, b);
+      cuenta[k] += v ? 1 : 0;
+    }
+  }
+  x.lw = w * .6;
+  for (const auto& kv : cuenta) {
+    if (kv.second == 0 && alOculta > .02) tira(x, {Pv[kv.first >> 3], Pv[kv.first & 7]}, alOculta);
+  }
+  for (int n = 0; n < 6; n++) {
+    if (vis[n]) {
+      std::vector<P> f;
+      for (int i : CC[n]) f.push_back(Pv[i]);
+      relleno(x, f, alCara);
+    }
+  }
+  x.lw = w;
+  for (const auto& kv : cuenta) {
+    if (kv.second) tira(x, {Pv[kv.first >> 3], Pv[kv.first & 7]}, 1);
+  }
+  tapar(x, Pv);
+  x.ga = 1;
+}
+
+// Alfabeto de trazos (rejilla 4 x 6, y hacia abajo): latinas, griegas,
+// cirilicas y katakana, solo con polilineas.
+using Glifo = std::vector<std::vector<std::array<double, 2>>>;
+inline const std::vector<Glifo>& glifos() {
+  static const std::vector<Glifo> G = {
+      {{{0, 6}, {2, 0}, {4, 6}}, {{.8, 4}, {3.2, 4}}},                                     // A
+      {{{4, 0}, {0, 0}, {0, 6}, {4, 6}}, {{0, 3}, {3, 3}}},                                // E
+      {{{0, 0}, {0, 6}}, {{4, 0}, {0, 3.4}, {4, 6}}},                                      // K
+      {{{0, 6}, {0, 0}, {2, 3.5}, {4, 0}, {4, 6}}},                                        // M
+      {{{0, 6}, {0, 0}, {4, 6}, {4, 0}}},                                                  // N
+      {{{0, 6}, {0, 0}, {3.2, 0}, {4, 1}, {4, 2.1}, {3.2, 3}, {0, 3}}, {{2, 3}, {4, 6}}},  // R
+      {{{4, .9}, {3.1, 0}, {.9, 0}, {0, .9}, {0, 2.1}, {.9, 3}, {3.1, 3}, {4, 3.9}, {4, 5.1}, {3.1, 6}, {.9, 6}, {0, 5.1}}},  // S
+      {{{0, 0}, {4, 0}, {0, 6}, {4, 6}}},                                                  // Z
+      {{{0, 0}, {4, 6}}, {{4, 0}, {0, 6}}},                                                // X
+      {{{0, 0}, {4, 0}}, {{2, 0}, {2, 6}}},                                                // T
+      {{{0, 0}, {0, 6}}, {{4, 0}, {4, 6}}, {{0, 3}, {4, 3}}},                              // H
+      {{{0, 0}, {0, 6}, {4, 6}}},                                                          // L
+      {{{4, 0}, {0, 0}, {2.4, 3}, {0, 6}, {4, 6}}},                                        // Σ
+      {{{0, 6}, {2, 0}, {4, 6}, {0, 6}}},                                                  // Δ
+      {{{0, 6}, {0, 0}, {4, 0}, {4, 6}}},                                                  // Π
+      {{{0, 6}, {1.4, 6}, {1.4, 4.7}, {.2, 3.4}, {.2, 1.3}, {1.2, 0}, {2.8, 0}, {3.8, 1.3}, {3.8, 3.4}, {2.6, 4.7}, {2.6, 6}, {4, 6}}},  // Ω
+      {{{0, 0}, {0, 2.4}, {1, 3.6}, {3, 3.6}, {4, 2.4}, {4, 0}}, {{2, 0}, {2, 6}}},        // Ψ
+      {{{.6, 0}, {1.5, 0}, {4, 6}}, {{2.4, 2.6}, {0, 6}}},                                 // λ
+      {{{0, 0}, {4, 6}}, {{4, 0}, {0, 6}}, {{2, 0}, {2, 6}}},                              // Ж
+      {{{4, 6}, {4, 0}, {.8, 0}, {0, 1}, {0, 2.1}, {.8, 3}, {4, 3}}, {{2, 3}, {0, 6}}},    // Я
+      {{{.4, .6}, {3.6, .6}}, {{2, .6}, {2, 5.4}}, {{0, 5.4}, {4, 5.4}}},                  // エ
+      {{{2, 0}, {2, 1.3}}, {{0, 3.1}, {0, 1.3}, {4, 1.3}, {4, 3}, {3, 5}, {1.3, 6}}},      // ウ
+      {{{0, 0}, {0, 6}, {4, 6}}, {{4, 1.5}, {0, 3.1}}},                                    // ヒ
+      {{{.4, .5}, {3.6, .5}, {0, 6}}, {{2.2, 3.3}, {4, 6}}},                               // ス
+      {{{1, 0}, {1, 6}}, {{1, 2.2}, {4, 4.1}}},                                            // ト
+      {{{0, .6}, {4, .6}}, {{0, 3}, {4, 3}}, {{0, 5.4}, {4, 5.4}}},                        // Ξ
+  };
+  return G;
+}
+inline int glN(int n) {
+  const int m = static_cast<int>(glifos().size());
+  return (((n * 11 + 3) % m) + m) % m;  // nunca repite dos seguidas
+}
+inline void glifo(X& x, int g, double u, const Tr& T, double z, double al) {
+  for (const auto& pl : glifos()[g]) {
+    std::vector<P> pts;
+    pts.reserve(pl.size());
+    for (const auto& p : pl) pts.push_back(T({(p[0] - 2) * u, (p[1] - 3) * u, z}));
+    tira(x, pts, al);
+  }
+}
+// Letra con volumen: cara de atras tenue, puentes y cara de delante fuerte.
+inline void glifoExtruido(X& x, int g, double u, const Tr& T, double gr, double wf, const Col& colF,
+                           const Col& colA, bool puentes) {
+  x.ss = colA;
+  x.lw = wf * .55;
+  glifo(x, g, u, T, -gr, .5);
+  if (puentes) {
+    x.lw = wf * .45;
+    for (const auto& pl : glifos()[g])
+      for (const auto& p : pl)
+        tira(x, {T({(p[0] - 2) * u, (p[1] - 3) * u, gr}), T({(p[0] - 2) * u, (p[1] - 3) * u, -gr})}, .5);
+  }
+  x.ss = colF;
+  x.lw = wf;
+  glifo(x, g, u, T, gr, 1);
+  x.ga = 1;
+}
