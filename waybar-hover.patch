+// ── Constelacion (creada a eleccion suya, 2026-11-11; FLUIDA
+// 2026-11-18: menos estatica — deriva continua, respiracion de
+// tamano con ritmo propio, hilos que aparecen y se apagan; el
+// movimiento ya no depende del nivel) ──────────
+// Estrellas que NO estan fijas: cada una deriva despacio por
+// el lienzo (campos seno desfasados), se AGITA en
+// proporcion al nivel de su zona (a mas sonido, mas
+// vibracion y mas brillo), titila mas rapido donde mas
+// suena y se conecta con hilos de luz con sus vecinas
+// cercanas cuando ambas zonas estan vivas. Sin estado: la
+// posicion es funcion pura del indice, el tick y el nivel.
+void WaveCanvas::drawConstelacion(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  const double mid = h / 2.0;
+  // Lienzo degenerado (la barra se esta redimensionando): con w<8
+  // o h<4 los clamps de abajo tendrian hi<lo y libstdc++ aborta
+  // (__glibcxx_assert_fail) — 4 crashes 2026-11-18. No hay nada que
+  // dibujar aqui; el siguiente frame ya tendra tamano normal.
+  if (w < 16.0 || h < 8.0) return;
+  const int M = 72;
+  auto muestras = [M](const std::vector<double>& src) {
+    std::vector<double> out(M, 0.0);
+    const size_t n = src.size();
+    if (n == 0) {
+      return out;
+    }
+    for (int i = 0; i < M; ++i) {
+      const double x = static_cast<double>(i) / (M - 1) * static_cast<double>(n - 1);
+      const size_t j = static_cast<size_t>(x);
+      double f = x - static_cast<double>(j);
+      f = (1.0 - std::cos(f * M_PI)) / 2.0;
+      const double a = src[j];
+      const double b = src[std::min(n - 1, j + 1)];
+      out[i] = a * (1.0 - f) + b * f;
+    }
+    return out;
+  };
+  auto ruido = [](double semilla) {
+    const double x = std::sin(semilla) * 43758.5453;
+    return x - std::floor(x);
+  };
+  const auto vs = muestras(values_);
+  const int NS = 22;
+  const double margen = 4.0;
+  const double util = w - 2 * margen;
+  struct Estrella {
+    double x, y, v, r, brillo;
+  };
+  std::vector<Estrella> es;
+  es.reserve(NS);
+  for (int i = 0; i < NS; ++i) {
+    const double xn0 = 0.03 + 0.94 * ruido(i * 13.73 + 4.7);
+    const double yo0 = (ruido(i * 29.31 + 9.1) - 0.5) * 0.88;
+    const double xn = xn0 + 0.085 * std::sin(tick_ * 0.020 + i * 2.39)
+                      + 0.045 * std::sin(tick_ * 0.008 + i * 1.13);
+    const int idx = std::clamp(static_cast<int>(xn * (M - 1)), 0, M - 1);
+    const double v = std::clamp(vs[idx], 0.0, 1.0);
+    const double yo = yo0 + 0.22 * std::sin(tick_ * 0.016 + i * 1.71)
+                      + 0.10 * std::sin(tick_ * 0.007 + i * 3.05);
+    const double jx = (ruido(i * 91.7 + tick_ * 13.1) - 0.5) * v * 3.2;
+    const double jy = (ruido(i * 57.3 + tick_ * 17.7) - 0.5) * v * 2.4;
+    Estrella e;
+    e.x = margen + xn * util + jx;
+    e.y = mid + yo * h * (0.5 + 0.6 * v) + jy;
+    e.v = v;
+    const double respira = 0.5 + 0.5 * std::sin(tick_ * (0.045 + 0.02 * (i % 5)) + i * 2.7);
+    const double pulso = 0.5 + 0.5 * std::sin(tick_ * (0.10 + 0.25 * v) + i * 1.3);
+    const double base = 0.9 + v * 1.2;
+    e.r = 2.0 * base * (0.55 + 0.75 * respira) * (0.8 + 0.4 * pulso);
+    // El circulo entero debe caber en el lienzo: el centro se limita con
+    // margen de radio para que el punto nunca se corte en los bordes.
+    e.x = std::clamp(e.x, margen + e.r, std::max(margen + e.r, margen + util - e.r));
+    e.y = std::clamp(e.y, e.r + 2.0, std::max(e.r + 2.0, h - 2.0 - e.r));
+    e.brillo = 0.55 + 0.45 * respira;
+    es.push_back(e);
+  }
+  cr->set_line_width(0.7);
+  for (int i = 0; i < NS; ++i) {
+    for (int j = i + 1; j < NS; ++j) {
+      const double dx = es[i].x - es[j].x;
+      const double dy = es[i].y - es[j].y;
+      const double dist = std::sqrt(dx * dx + dy * dy);
+      const double cerca = w * 0.30;
+      if (dist < cerca) {
+        const double fuerza = std::min(es[i].v, es[j].v);
+        const double a = 0.55 * (0.35 + 0.65 * fuerza) * (1.0 - dist / cerca)
+                      * (0.6 + 0.4 * std::sin(tick_ * 0.05 + i + j));
+        if (a > 0.02) {
+          cr->set_source_rgba(0.85, 0.97, 0.72, a);
+          cr->move_to(es[i].x, es[i].y);
+          cr->line_to(es[j].x, es[j].y);
+          cr->stroke();
+        }
+      }
+    }
+  }
+  for (const auto& e : es) {
+    const double xn = (e.x - margen) / util;
+    double r, g, b;
+    if (!gradientColor(std::clamp(xn, 0.0, 1.0), r, g, b)) {
+      r = g = b = 1.0;
+    }
+    cr->set_source_rgba(r, g, b, 0.05 + 0.95 * e.brillo);
+    cr->arc(e.x, e.y, e.r, 0, 2 * M_PI);
+    cr->fill();
+    cr->set_source_rgba(0.96, 1.0, 0.88, 0.9 * e.brillo);
+    cr->arc(e.x, e.y, e.r * 0.45, 0, 2 * M_PI);
+    cr->fill();
+  }
+}
