+#include "modules/wave.hpp"
+
+#include <gtk/gtk.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cmath>
+
+namespace waybar::modules {
+
+// ── WaveCanvas ─────────────────────────────────────────────────────
+// The user's final word on the shape (2026-11-08): DOTS — round
+// like the ● of the segmented level dots — never bars, not even
+// small ones. Each column is a filled circle centered on the
+// middle line; the level drives its DIAMETER (curve v^1.35, from
+// ~3 px at rest to 20 px at full, so the big dots really read).
+// The columns are INSET from the canvas edges by the max radius,
+// so a fully grown dot is never clipped at the sides. The color
+// comes from a DYNAMIC gradient: a cyclic sweep between matugen
+// theme colors whose phase keeps rolling (a full turn in ~10 s),
+// so no dot keeps one color — the tonalities travel the row.
+
+WaveCanvas::WaveCanvas() {
+  Glib::signal_timeout().connect(
+      [this]() {
+        phase_ = std::fmod(phase_ + 0.005, 1.0);
+        if (!values_.empty()) {
+          queue_draw();
+        }
+        return true;
+      },
+      50);
+}
+
+void WaveCanvas::setColor(const std::string& spec) { color_ = spec; }
+
+void WaveCanvas::setGradient(const std::vector<std::string>& stops) { gradient_ = stops; }
+
+bool WaveCanvas::gradientColor(double t, double& r, double& g, double& b) {
+  if (gradient_.size() < 2) {
+    return resolveColor(gradient_.empty() ? color_ : gradient_.front(), r, g, b);
+  }
+  std::vector<std::array<double, 3>> stops;
+  for (auto const& name : gradient_) {
+    double sr, sg, sb;
+    if (resolveColor(name, sr, sg, sb)) {
+      stops.push_back({sr, sg, sb});
+    }
+  }
+  if (stops.empty()) {
+    return false;
+  }
+  if (stops.size() == 1) {
+    r = stops[0][0];
+    g = stops[0][1];
+    b = stops[0][2];
+    return true;
+  }
+  // Cyclic: the sweep wraps from the last stop back to the first,
+  // and the rolling phase_ shifts every column's position in the
+  // cycle, so the colors travel instead of sitting still.
+  const double pos = std::fmod(std::clamp(t, 0.0, 1.0) + phase_, 1.0) *
+                     static_cast<double>(stops.size());
+  const size_t idx = static_cast<size_t>(pos) % stops.size();
+  const size_t nxt = (idx + 1) % stops.size();
+  const double f = pos - std::floor(pos);
+  r = stops[idx][0] + (stops[nxt][0] - stops[idx][0]) * f;
+  g = stops[idx][1] + (stops[nxt][1] - stops[idx][1]) * f;
+  b = stops[idx][2] + (stops[nxt][2] - stops[idx][2]) * f;
+  return true;
+}
+
+void WaveCanvas::setValues(const std::vector<double>& values) {
+  if (values.size() == values_.size()) {
+    bool same = true;
+    for (size_t i = 0; i < values.size(); ++i) {
+      if (std::abs(values[i] - values_[i]) > 0.004) {
+        same = false;
+        break;
+      }
+    }
+    if (same) {
+      return;
+    }
+  }
+  values_ = values;
+  queue_draw();
+}
+
+bool WaveCanvas::resolveColor(const std::string& name, double& r, double& g, double& b) {
+  GdkRGBA named{};
+  if (gtk_style_context_lookup_color(get_style_context()->gobj(), name.c_str(), &named)) {
+    r = named.red;
+    g = named.green;
+    b = named.blue;
+    return true;
+  }
+  GdkRGBA rgba{};
+  if (gdk_rgba_parse(&rgba, name.c_str())) {
+    r = rgba.red;
+    g = rgba.green;
+    b = rgba.blue;
+    return true;
+  }
+  return false;
+}
+
+bool WaveCanvas::on_draw(const Cairo::RefPtr<Cairo::Context>& cr) {
+  const auto alloc = get_allocation();
+  const double w = alloc.get_width();
+  const double h = alloc.get_height();
+  const size_t n = values_.size();
+  if (w < 4 || h < 4 || n == 0) {
+    return false;
+  }
+  const double mid = h / 2.0;
+  const double min_d = 3.2;
+  const double max_d = std::min(20.0, h - 6.0);
+  // Inset the columns by the max radius (+1 px of air) so the
+  // first and last dots are always drawn complete, never clipped
+  // by the canvas edges when they grow.
+  const double inset = max_d / 2.0 + 1.0;
+  if (w < 2 * inset + 4) {
+    return false;
+  }
+  const double span = w - 2 * inset;
+
+  for (size_t i = 0; i < n; ++i) {
+    const double v = std::clamp(values_[i], 0.0, 1.0);
+    const double d = min_d + std::pow(v, 1.35) * (max_d - min_d);
+    const double t = n > 1 ? static_cast<double>(i) / static_cast<double>(n - 1) : 0.5;
+    const double cx = inset + span * t;
+    double r, g, b;
+    if (!gradientColor(t, r, g, b)) {
+      r = g = b = 1.0;
+    }
+    cr->set_source_rgba(r, g, b, 0.92);
+    cr->arc(cx, mid, d / 2.0, 0, 2 * M_PI);
+    cr->fill();
+  }
+  return false;
+}
+
+// ── Wave ───────────────────────────────────────────────────────────
+// The worker model is the ring module's: signal-only waits,
+// interval polls, and with neither, the exec is a continuous
+// stream of JSON lines (the cava converter at 30 fps).
+
+Wave::Wave(const std::string& name, const std::string& id, const Json::Value& config,
+           const std::string& output_name)
+    : AModule(config, "wave-" + name, id, true, true), name_(name), output_name_(output_name) {
+  full_width_ = config["width"].isNumeric() ? config["width"].asDouble() : 86.0;
+  height_ = config["height"].isNumeric() ? config["height"].asDouble() : 26.0;
+  // Start collapsed: the width only opens (animated) when sound
+  // actually arrives, so the bar boots with the center at rest.
+  canvas_.set_size_request(0, static_cast<int>(height_));
+  if (config["color"].isString()) {
+    canvas_.setColor(config["color"].asString());
+  }
+  if (config["gradient"].isArray()) {
+    std::vector<std::string> stops;
+    for (auto const& s : config["gradient"]) {
+      if (s.isString()) {
+        stops.push_back(s.asString());
+      }
+    }
+    if (!stops.empty()) {
+      canvas_.setGradient(stops);
+    }
+  }
+
+  wrap_.set_name("wave-" + name);
+  wrap_.get_style_context()->add_class(MODULE_CLASS);
+  wrap_.set_halign(Gtk::ALIGN_CENTER);
+  wrap_.set_valign(Gtk::ALIGN_CENTER);
+  wrap_.add(canvas_);
+  event_box_.add(wrap_);
+
+  canvas_.signal_style_updated().connect([this]() { canvas_.queue_draw(); });
+
+  if (config["interval"].isNumeric()) {
+    interval_ = std::chrono::seconds(static_cast<long>(config["interval"].asDouble()));
+  }
+
+  if (!config["signal"].empty() && config["interval"].empty()) {
+    waitingWorker();
+  } else if (interval_.count() > 0) {
+    delayWorker();
+  } else if (config["exec"].isString()) {
+    continuousWorker();
+  } else {
+    dp.emit();
+  }
+}
+
+Wave::~Wave() {
+  restart_connection_.disconnect();
+  hold_conn_.disconnect();
+  anim_conn_.disconnect();
+  if (continuous_stream_) {
+    continuous_stream_->stop();
+  }
+}
+
+// ── Fluid visibility ───────────────────────────────────────────────
+// Silence does not hide the module right away: it HOLDs its width
+// for 5 s (brief pauses are invisible to the layout), then the
+// width animates to 0. Sound cancels any pending collapse and
+// animates the width back up. The neighbours of modules-center
+// slide with the animation instead of snapping (user's spec).
+
+void Wave::onSoundFrame() {
+  hold_conn_.disconnect();
+  if (vis_ == Vis::Gone || vis_ == Vis::Collapsing || vis_ == Vis::Holding) {
+    vis_ = Vis::Expanding;
+    target_width_ = full_width_;
+    startAnim();
+  }
+}
+
+void Wave::onSilenceFrame() {
+  if (vis_ == Vis::Shown || vis_ == Vis::Expanding) {
+    vis_ = Vis::Holding;
+    hold_conn_.disconnect();
+    hold_conn_ = Glib::signal_timeout().connect(
+        [this]() {
+          if (vis_ == Vis::Holding) {
+            vis_ = Vis::Collapsing;
+            target_width_ = 0.0;
+            startAnim();
+          }
+          return false;
+        },
+        5000);
+  }
+}
+
+void Wave::startAnim() {
+  if (!anim_conn_.connected()) {
+    anim_conn_ = Glib::signal_timeout().connect(sigc::mem_fun(*this, &Wave::animTick), 16);
+  }
+}
+
+bool Wave::animTick() {
+  const double diff = target_width_ - shown_width_;
+  if (std::abs(diff) < 0.8) {
+    shown_width_ = target_width_;
+    canvas_.set_size_request(static_cast<int>(shown_width_ + 0.5), static_cast<int>(height_));
+    if (vis_ == Vis::Expanding) {
+      vis_ = Vis::Shown;
+    } else if (vis_ == Vis::Collapsing) {
+      vis_ = Vis::Gone;
+    }
+    return false;
+  }
+  shown_width_ += diff * 0.11;
+  canvas_.set_size_request(static_cast<int>(shown_width_ + 0.5), static_cast<int>(height_));
+  return true;
+}
+
+void Wave::delayWorker() {
+  if (!config_["exec"].isString() && !config_["exec-if"].isString()) {
+    dp.emit();
+    return;
+  }
+
+  thread_ = [this] {
+    for (auto it = this->pid_children_.begin(); it != this->pid_children_.end();) {
+      int status = 0;
+      const auto pid = static_cast<pid_t>(*it);
+      const auto waited = waitpid(pid, &status, WNOHANG);
+      if (waited == 0) {
+        ++it;
+        continue;
+      }
+      if (waited == -1 && errno != ECHILD) {
+        ++it;
+        continue;
+      }
+      it = this->pid_children_.erase(it);
+    }
+
+    bool can_update = true;
+    if (config_["exec-if"].isString()) {
+      output_ = util::command::execNoRead(config_["exec-if"].asString());
+      if (output_.exit_code != 0) {
+        can_update = false;
+        dp.emit();
+      }
+    }
+    if (can_update) {
+      if (config_["exec"].isString()) {
+        output_ = util::command::exec(config_["exec"].asString(), output_name_);
+      }
+      dp.emit();
+    }
+    thread_.sleep_for(interval_);
+  };
+}
+
+void Wave::continuousWorker() {
+  continuous_stream_ = std::make_unique<util::command::LineStream>(
+      output_name_,
+      [this](const std::string& output) {
+        output_ = {.exit_code = 0, .out = output};
+        dp.emit();
+      },
+      [this](int exit_code) { handleContinuousProcessExit(exit_code); });
+  startContinuousProcess(true);
+}
+
+void Wave::startContinuousProcess(bool throw_on_failure) {
+  const auto cmd = config_["exec"].asString();
+
+  try {
+    continuous_stream_->start(cmd);
+  } catch (const Glib::SpawnError& e) {
+    if (throw_on_failure) {
+      throw std::runtime_error("Unable to open " + cmd + ": " + e.what().raw());
+    }
+    output_ = {.exit_code = 1, .out = ""};
+    dp.emit();
+    spdlog::error("Unable to restart {}: {}", name_, e.what().raw());
+    scheduleContinuousRestart();
+  } catch (const std::exception& e) {
+    if (throw_on_failure) {
+      throw;
+    }
+    output_ = {.exit_code = 1, .out = ""};
+    dp.emit();
+    spdlog::error("Unable to restart {}: {}", name_, e.what());
+    scheduleContinuousRestart();
+  }
+}
+
+void Wave::handleContinuousProcessExit(int exit_code) {
+  if (exit_code != 0) {
+    output_ = {.exit_code = exit_code, .out = ""};
+    dp.emit();
+    spdlog::error("{} stopped unexpectedly, is it endless?", name_);
+  }
+
+  scheduleContinuousRestart();
+}
+
+void Wave::scheduleContinuousRestart() {
+  restart_connection_.disconnect();
+  if (!config_["restart-interval"].isNumeric() || config_["restart-interval"].asDouble() <= 0) {
+    return;
+  }
+
+  restart_connection_ = Glib::signal_timeout().connect(
+      [this] {
+        startContinuousProcess(false);
+        return false;
+      },
+      std::max(1U, static_cast<unsigned>(config_["restart-interval"].asDouble() * 1000)));
+}
+
+void Wave::waitingWorker() {
+  thread_ = [this] {
+    bool can_update = true;
+    if (config_["exec-if"].isString()) {
+      output_ = util::command::execNoRead(config_["exec-if"].asString());
+      if (output_.exit_code != 0) {
+        can_update = false;
+        dp.emit();
+      }
+    }
+    if (can_update) {
+      if (config_["exec"].isString()) {
+        output_ = util::command::exec(config_["exec"].asString(), output_name_);
+      }
+      dp.emit();
+    }
+    thread_.sleep();
+  };
+}
+
+void Wave::refresh(int sig) {
+#ifdef SIGRTMIN
+  if (config_["signal"].isInt() && sig == SIGRTMIN + config_["signal"].asInt()) {
+    thread_.wake_up();
+  }
+#endif
+}
+
+void Wave::handleEvent() {
+  if (!config_["exec-on-event"].isBool() || config_["exec-on-event"].asBool()) {
+    thread_.wake_up();
+  }
+}
+
+bool Wave::handleScroll(GdkEventScroll* e) {
+  auto ret = AModule::handleScroll(e);
+  handleEvent();
+  return ret;
+}
+
+bool Wave::handleToggle(GdkEventButton* const& e) {
+  auto ret = AModule::handleToggle(e);
+  handleEvent();
+  return ret;
+}
+
+auto Wave::update() -> void {
+  if ((config_["exec"].isString() || config_["exec-if"].isString()) &&
+      (output_.out.empty() || output_.exit_code != 0)) {
+    event_box_.hide();
+  } else {
+    parseOutputJson();
+
+    bool silence = false;
+    for (auto const& c : class_) {
+      if (c == "hide") {
+        silence = true;
+      }
+    }
+    if (silence) {
+      onSilenceFrame();
+    } else {
+      onSoundFrame();
+    }
+
+    canvas_.setValues(values_);
+    if (tooltipEnabled()) {
+      event_box_.set_tooltip_markup(tooltip_);
+    }
+
+    // The "hide" class reaches the widget only in the Gone state:
+    // while holding or collapsing the module stays fully opaque
+    // and its shrinking width is what the eye follows.
+    auto style = wrap_.get_style_context();
+    for (auto const& c : style->list_classes()) {
+      if (c == MODULE_CLASS) {
+        continue;
+      }
+      style->remove_class(c);
+    }
+    if (vis_ == Vis::Gone) {
+      style->add_class("hide");
+    }
+    event_box_.show();
+  }
+  AModule::update();
+}
+
+void Wave::parseOutputJson() {
+  std::istringstream output(output_.out);
+  std::string line;
+  class_.clear();
+  auto sanitize = [](const std::string& s) -> Glib::ustring {
+    Glib::ustring value = s;
+    if (!value.validate()) {
+      value = value.make_valid();
+    }
+    return value;
+  };
+  while (getline(output, line)) {
+    auto parsed = parser_.parse(line);
+    tooltip_ = sanitize(parsed["tooltip"].asString());
+    if (parsed["class"].isString()) {
+      class_.push_back(parsed["class"].asString());
+    } else if (parsed["class"].isArray()) {
+      for (auto const& c : parsed["class"]) {
+        class_.push_back(c.asString());
+      }
+    }
+    values_.clear();
+    if (parsed["values"].isArray()) {
+      for (auto const& v : parsed["values"]) {
+        if (v.isNumeric()) {
+          values_.push_back(std::clamp(v.asDouble(), 0.0, 1.0));
+        }
+      }
+    }
+    break;
+  }
+}
+
