+#pragma once
+
+#include <array>
+#include <chrono>
+#include <string>
+#include <vector>
+
+#include "AModule.hpp"
+#include "util/command.hpp"
+#include "util/command_line_stream.hpp"
+#include "util/json.hpp"
+#include "util/sleeper_thread.hpp"
+
+namespace waybar::modules {
+
+// Local module (2026-11-08): the music visualizer for the two cava
+// spots in modules-center. The canvas draws CENTERED DOTS (like
+// the ● of the level dots in the brightness/volume widgets) whose
+// diameter grows with the band value — dots, never bars — fed by
+// an exec stream of JSON {"values": [0..1, ...]} frames (cava via
+// a converter). Colors are a dynamic gradient across the columns
+// between theme NAMES resolved at draw time (matugen palette).
+//
+// Fluid show/hide (user's spec, 2026-11-08): the center group must
+// never jump when the sound pauses. When silence starts, the
+// module keeps its full width for 5 s (a brief pause changes
+// nothing); only then does the width animate down to 0, and when
+// sound returns the width animates back up — the neighbours slide
+// instead of snapping. Registered as "wave/<name>".
+class WaveCanvas : public Gtk::DrawingArea {
+ public:
+  WaveCanvas();
+  void setValues(const std::vector<double>& values);
+  void setColor(const std::string& spec);
+  void setGradient(const std::vector<std::string>& stops);
+  // Dictation look (2026-11-08): "onda que termina en puntos" —
+  // bars near the inner edge, dots toward the outer edge.
+  void setOnda(bool onda);
+  void setInnerRight(bool inner_right);
+  void setChispas(bool chispas);
+  void setSimbolos(bool simbolos);
+  void setCuerdas(bool cuerdas);
+  void setAdn(bool adn);
+  void setPanal(bool panal);
+  void setHexagonos(bool hexagonos);
+  void setOleaje(bool oleaje);
+  void setEstela(bool estela);
+
+ protected:
+  bool on_draw(const Cairo::RefPtr<Cairo::Context>& cr) override;
+
+ private:
+  void drawOnda(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  void drawChispas(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  void drawSimbolos(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  void drawCuerdas(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  void drawAdn(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  void drawPanal(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  void drawHexagonos(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  void drawOleaje(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  void drawEstela(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h);
+  bool resolveColor(const std::string& name, double& r, double& g, double& b);
+  bool gradientColor(double t, double& r, double& g, double& b);
+
+  std::vector<double> values_;
+  // Interpolated display values (2026-11-09): the dots draw these,
+  // eased toward values_ on the 25 ms canvas tick, so the motion is
+  // evenly paced at 40 fps instead of jumping at the data rate.
+  std::vector<double> disp_;
+  std::vector<std::vector<double>> hist_;
+  // Resolved gradient stops, cached ~0.5 s: resolving theme colors
+  // walks the CSS cascade, far too costly to redo per dot per frame.
+  std::vector<std::array<double, 3>> stops_cache_;
+  int stops_tick_ = -100000;
+  bool stops_ok_ = false;
+  bool onda_ = false;
+  bool chispas_ = false;
+  bool simbolos_ = false;
+  bool cuerdas_ = false;
+  bool adn_ = false;
+  bool panal_ = false;
+  bool hexagonos_ = false;
+  bool oleaje_ = false;
+  bool estela_ = false;
+  int tick_ = 0;
+  bool inner_right_ = false;
+  std::string color_{"waybar-accent"};
+  std::vector<std::string> gradient_;
+  double phase_ = 0.0;
+};
+
+class Wave : public AModule {
+ public:
+  Wave(const std::string&, const std::string&, const Json::Value&, const std::string&);
+  ~Wave() override;
+  auto update() -> void override;
+  void refresh(int /*signal*/) override;
+
+ private:
+  void delayWorker();
+  void waitingWorker();
+  void continuousWorker();
+  void startContinuousProcess(bool throw_on_failure);
+  void handleContinuousProcessExit(int exit_code);
+  void scheduleContinuousRestart();
+  void handleEvent();
+  bool handleScroll(GdkEventScroll* e) override;
+  bool handleToggle(GdkEventButton* const& e) override;
+  void parseOutputJson();
+
+  // Fluid visibility state machine.
+  void onSoundFrame();
+  void onSilenceFrame();
+  bool animTick();
+  void startAnim();
+  enum class Vis { Gone, Expanding, Shown, Holding, Collapsing };
+  Vis vis_ = Vis::Gone;
+  double full_width_ = 86.0;
+  double height_ = 26.0;
+  double shown_width_ = 0.0;
+  double target_width_ = 0.0;
+  sigc::connection anim_conn_;
+  sigc::connection hold_conn_;
+
+  const std::string name_;
+  const std::string output_name_;
+  std::chrono::seconds interval_{0};
+
+  Gtk::Box wrap_;
+  WaveCanvas canvas_;
+
+  std::string tooltip_;
+  std::vector<std::string> class_;
+  std::vector<double> values_;
+  util::command::res output_;
+  util::JsonParser parser_;
+  std::unique_ptr<util::command::LineStream> continuous_stream_;
+  sigc::connection restart_connection_;
+  util::SleeperThread thread_;
+};
