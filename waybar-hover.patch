+
+void WaveCanvas::drawIcono(const Cairo::RefPtr<Cairo::Context>& cr, double w, double h) {
+  if (w < 16 || h < 8) {
+    return;
+  }
+  // Colores del tema (matugen), cache ~1 s: hexagono = color del
+  // modulo (acento), interior = primera parada del degradado
+  // (terciario), brillo = texto, error = rojo del tema. Si alguno
+  // no resuelve, se queda el del diseno.
+  if (tick_ - icono_cols_tick_ > 30 || tick_ < icono_cols_tick_) {
+    icono_cols_tick_ = tick_;
+    iconos::Paleta base;
+    icono_cols_ = {base.azul.r,  base.azul.g,  base.azul.b,  base.verde.r,  base.verde.g,  base.verde.b,
+                   base.blanco.r, base.blanco.g, base.blanco.b, base.rojo.r, base.rojo.g, base.rojo.b};
+    resolveColor(color_, icono_cols_[0], icono_cols_[1], icono_cols_[2]);
+    resolveColor(gradient_.empty() ? std::string("waybar-tertiary") : gradient_.front(),
+                 icono_cols_[3], icono_cols_[4], icono_cols_[5]);
+    resolveColor("waybar-text", icono_cols_[6], icono_cols_[7], icono_cols_[8]);
+    resolveColor("waybar-error", icono_cols_[9], icono_cols_[10], icono_cols_[11]);
+  }
+  iconos::Paleta pal;
+  pal.azul = {icono_cols_[0], icono_cols_[1], icono_cols_[2]};
+  pal.verde = {icono_cols_[3], icono_cols_[4], icono_cols_[5]};
+  pal.blanco = {icono_cols_[6], icono_cols_[7], icono_cols_[8]};
+  pal.rojo = {icono_cols_[9], icono_cols_[10], icono_cols_[11]};
+  int dt = tick_ - icono_t0_;
+  if (dt < 0) {
+    dt = 0;
+    icono_t0_ = tick_;
+  }
+  double t = dt * 0.033 * icono_vel_;
+  // Los de UNA pasada (logo-3d) terminan en el logo plano y de ahi
+  // nace el reposo, sin salto y sin bucle.
+  const double dur = iconos::duracion(icono_);
+  if (dur > 0.0 && t >= dur) {
+    icono_ = iconos::esReposo(icono_sigue_) ? icono_sigue_ : std::string("reposo-t");
+    icono_t0_ = tick_;
+    icono_vel_ = 1.0;
+    t = 0.0;
+  }
+  const double abre = iconos::esReposo(icono_) ? iconos::suave(t / 1.2) : 1.0;
+  iconos::dibujar(cr->cobj(), icono_, t, w, h, pal, abre);
+}
