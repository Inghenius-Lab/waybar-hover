diff --git a/src/modules/ring.cpp b/src/modules/ring.cpp
new file mode 100644
index 00000000..8383b52e
--- /dev/null
+++ b/src/modules/ring.cpp
@@ -0,0 +1,592 @@
+#include "modules/ring.hpp"
+
+#include <gtk/gtk.h>
+#include <spdlog/spdlog.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+
+namespace waybar::modules {
+
+// ── RingCanvas ─────────────────────────────────────────────────────
+
+RingCanvas::RingCanvas() = default;
+
+void RingCanvas::setGradient(std::vector<std::string> stops) {
+  if (!stops.empty()) {
+    stops_ = std::move(stops);
+  }
+}
+
+void RingCanvas::setThickness(double px) { thickness_ = px; }
+
+void RingCanvas::setSmooth(bool smooth) { smooth_ = smooth; }
+
+void RingCanvas::setTrackAlpha(double alpha) { track_alpha_ = std::clamp(alpha, 0.0, 1.0); }
+
+void RingCanvas::setArcColor(const std::string& spec) { arc_color_ = spec; }
+
+void RingCanvas::setIcon(const std::string& glyph, const std::string& color_spec) {
+  if (glyph != icon_glyph_ || color_spec != icon_color_) {
+    icon_glyph_ = glyph;
+    icon_color_ = color_spec;
+    queue_draw();
+  }
+}
+
+void RingCanvas::drawIcon(const Cairo::RefPtr<Cairo::Context>& cr, double cx, double cy,
+                          double diameter) {
+  if (icon_glyph_.empty()) {
+    return;
+  }
+  double r, g, b;
+  if (!resolveColor(icon_color_, r, g, b)) {
+    r = g = b = 1.0;
+  }
+  cr->set_source_rgb(r, g, b);
+
+  // Precise placement: with font hinting on, Pango snaps the layout
+  // origin to whole pixels while the extents stay fractional, so
+  // the icon lands up to half a pixel off the ring's center (the
+  // brightness sun made it obvious at this size). Unhinted
+  // rendering matches the ink extents exactly.
+  Cairo::FontOptions font_options;
+  font_options.set_hint_style(Cairo::HINT_STYLE_NONE);
+  font_options.set_hint_metrics(Cairo::HINT_METRICS_OFF);
+  font_options.set_antialias(Cairo::ANTIALIAS_SUBPIXEL);
+  cr->set_font_options(font_options);
+
+  auto layout = create_pango_layout(icon_glyph_);
+  Pango::FontDescription font("JetBrainsMono Nerd Font");
+  font.set_weight(Pango::WEIGHT_BOLD);
+  font.set_size(static_cast<int>(diameter * 0.46 * Pango::SCALE));
+  layout->set_font_description(font);
+
+  // Center by the glyph's INK box, not its advance box: Nerd Font
+  // glyphs carry asymmetric bearings, and centering the advance is
+  // what made the icon sit slightly off to one side.
+  Pango::Rectangle ink, logical;
+  layout->get_extents(ink, logical);
+  const double x = cx - (ink.get_x() + ink.get_width() / 2.0) / Pango::SCALE;
+  const double y = cy - (ink.get_y() + ink.get_height() / 2.0) / Pango::SCALE;
+  cr->move_to(x, y);
+  layout->show_in_cairo_context(cr);
+}
+
+void RingCanvas::setPercentage(double pct) {
+  target_ = std::clamp(pct, 0.0, 100.0);
+  if (!smooth_) {
+    shown_ = target_;
+    queue_draw();
+    return;
+  }
+  if (std::abs(target_ - shown_) < 0.35) {
+    shown_ = target_;
+    queue_draw();
+    return;
+  }
+  if (!anim_.connected()) {
+    anim_ = Glib::signal_timeout().connect(sigc::mem_fun(*this, &RingCanvas::tick), 16);
+  }
+}
+
+bool RingCanvas::tick() {
+  const double diff = target_ - shown_;
+  if (std::abs(diff) < 0.35) {
+    shown_ = target_;
+    queue_draw();
+    return false;
+  }
+  shown_ += diff * 0.22;
+  queue_draw();
+  return true;
+}
+
+bool RingCanvas::resolveColor(const std::string& name, double& r, double& g, double& b) {
+  // First choice: a named color of the live theme (@define-color in
+  // the loaded CSS — this is how the ring follows matugen). GTK
+  // 3.24's lookup_color returns a GdkRGBA.
+  GdkRGBA named{};
+  if (gtk_style_context_lookup_color(get_style_context()->gobj(), name.c_str(), &named)) {
+    r = named.red;
+    g = named.green;
+    b = named.blue;
+    return true;
+  }
+  // Fallback: a literal CSS color ("#e0b6ff", "rgb(...)", "red"...).
+  GdkRGBA rgba{};
+  if (gdk_rgba_parse(&rgba, name.c_str())) {
+    r = rgba.red;
+    g = rgba.green;
+    b = rgba.blue;
+    return true;
+  }
+  return false;
+}
+
+void RingCanvas::arcColor(double pct, double& r, double& g, double& b) {
+  if (stops_.size() == 1) {
+    if (!resolveColor(stops_[0], r, g, b)) {
+      r = g = b = 1.0;
+    }
+    return;
+  }
+  const double t =
+      std::clamp(pct, 0.0, 100.0) / 100.0 * static_cast<double>(stops_.size() - 1);
+  const auto i = std::min(static_cast<size_t>(t), stops_.size() - 2);
+  const double f = t - static_cast<double>(i);
+  double r1, g1, b1, r2, g2, b2;
+  if (!resolveColor(stops_[i], r1, g1, b1)) {
+    r1 = g1 = b1 = 1.0;
+  }
+  if (!resolveColor(stops_[i + 1], r2, g2, b2)) {
+    r2 = g2 = b2 = 1.0;
+  }
+  r = r1 + (r2 - r1) * f;
+  g = g1 + (g2 - g1) * f;
+  b = b1 + (b2 - b1) * f;
+}
+
+bool RingCanvas::on_draw(const Cairo::RefPtr<Cairo::Context>& cr) {
+  const auto alloc = get_allocation();
+  const double cx = alloc.get_width() / 2.0;
+  const double cy = alloc.get_height() / 2.0;
+  const double radius = std::min(alloc.get_width(), alloc.get_height()) / 2.0 - thickness_ / 2.0 - 0.5;
+  if (radius <= 1.0) {
+    return false;
+  }
+  cr->set_line_cap(Cairo::LINE_CAP_ROUND);
+  cr->set_line_width(thickness_);
+
+  // Track: the full circle in the first gradient color, dimmed.
+  // Keeping the whole circle readable matters: the eye measures
+  // ring-to-ring distances, and a too-dim track makes the gaps
+  // between partial arcs look uneven.
+  double r, g, b;
+  if (resolveColor(stops_.front(), r, g, b)) {
+    cr->set_source_rgba(r, g, b, track_alpha_);
+    cr->arc(cx, cy, radius, 0, 2 * M_PI);
+    cr->stroke();
+  }
+
+  // Arc: from the top, sweeping clockwise with the level. With an
+  // "arc-color" configured, the arc keeps that single tone at
+  // every level (the user's call: battery's full tone everywhere,
+  // not a different tone per ring); without it, the color walks
+  // the gradient stops as the percentage grows.
+  if (shown_ > 0.05) {
+    if (!arc_color_.empty() && resolveColor(arc_color_, r, g, b)) {
+      // flat tone from arc-color_
+    } else {
+      arcColor(shown_, r, g, b);
+    }
+    cr->set_source_rgb(r, g, b);
+    const double start = -M_PI / 2.0;
+    const double sweep = std::min(shown_, 100.0) / 100.0 * 2 * M_PI;
+    cr->arc(cx, cy, radius, start, start + sweep);
+    cr->stroke();
+  }
+
+  drawIcon(cr, cx, cy, std::min(alloc.get_width(), alloc.get_height()));
+  return false;
+}
+
+// ── Ring ───────────────────────────────────────────────────────────
+
+Ring::Ring(const std::string& name, const std::string& id, const Json::Value& config,
+           const std::string& output_name)
+    : AModule(config, "ring-" + name, id, true, true), name_(name), output_name_(output_name) {
+  const int size = config_["size"].isNumeric() ? static_cast<int>(config_["size"].asDouble()) : 28;
+  canvas_.set_size_request(size, size);
+  if (config_["thickness"].isNumeric()) {
+    canvas_.setThickness(config_["thickness"].asDouble());
+  }
+  if (config_["track-alpha"].isNumeric()) {
+    canvas_.setTrackAlpha(config_["track-alpha"].asDouble());
+  }
+  if (config_["gradient"].isArray()) {
+    std::vector<std::string> stops;
+    for (auto const& s : config_["gradient"]) {
+      if (s.isString()) {
+        stops.push_back(s.asString());
+      }
+    }
+    canvas_.setGradient(stops);
+  }
+  if (config_["smooth"].isBool()) {
+    canvas_.setSmooth(config_["smooth"].asBool());
+  }
+  if (config_["arc-color"].isString()) {
+    canvas_.setArcColor(config_["arc-color"].asString());
+  }
+
+  wrap_.set_name("ring-" + name);
+  wrap_.get_style_context()->add_class(MODULE_CLASS);
+  wrap_.set_halign(Gtk::ALIGN_CENTER);
+  wrap_.set_valign(Gtk::ALIGN_CENTER);
+  wrap_.add(canvas_);
+  // Optional level bar (JSON "bar"): the level pills show it next
+  // to the ring while hovering or adjusting, like their text
+  // widgets did — the ring itself is the at-a-glance indicator.
+  // The label lives in its own clip box whose width the module
+  // animates explicitly (parchment unroll/roll, ~0.4 s): at rest
+  // open the width is the label's natural width + slack, so the
+  // last dot always fits whole.
+  bar_label_.set_halign(Gtk::ALIGN_START);
+  bar_label_.set_ellipsize(Pango::ELLIPSIZE_NONE);
+  bar_box_.add(bar_label_);
+  // The label is born shown: the BOX gates its visibility. (A
+  // plain show() on the box does not show children, and a label
+  // measured while its chain is hidden reports width 0 — both
+  // verified with a standalone probe, 2026-11-08.)
+  bar_label_.show();
+  bar_box_.set_no_show_all(true);
+  bar_box_.set_size_request(0, -1);
+  bar_box_.hide();
+  wrap_.pack_start(bar_box_, false, false, 0);
+  event_box_.add(wrap_);
+
+  // A matugen re-theme swaps the palette under us: redraw with it.
+  canvas_.signal_style_updated().connect([this]() { canvas_.queue_draw(); });
+
+  if (config_["interval"].isNumeric()) {
+    interval_ = std::chrono::seconds(static_cast<long>(config_["interval"].asDouble()));
+  }
+
+  // Same worker model as the custom module: signal-only waits,
+  // otherwise poll on the interval.
+  if (!config_["signal"].empty() && config_["interval"].empty()) {
+    waitingWorker();
+  } else if (interval_.count() > 0) {
+    delayWorker();
+  } else if (config_["exec"].isString()) {
+    // No interval and no signal: the exec is a stream that prints
+    // one JSON line per update (e.g. the dictation daemon, whose
+    // state changes on its own: recording, transcribing...).
+    continuousWorker();
+  } else {
+    dp.emit();
+  }
+}
+
+Ring::~Ring() {
+  restart_connection_.disconnect();
+  if (bar_tick_id_ != 0) {
+    bar_box_.remove_tick_callback(bar_tick_id_);
+    bar_tick_id_ = 0;
+  }
+  if (continuous_stream_) {
+    continuous_stream_->stop();
+  }
+}
+
+// ── Parchment reveal ───────────────────────────────────────────────
+// A duration tween on the widget's frame clock: easeInOutSine
+// over 750 ms to open and 650 ms to close. Tuning history (the
+// user judges this by eye): the exponential lerp lurched and
+// dragged; cubic at 420/360 was still "muy brusco" — too fast
+// and its mid-sweep too eager. Sine has the gentlest peak
+// velocity of the easeInOut family and, at these durations, the
+// unroll finally reads as a parchment, not a pop. One step per
+// rendered frame (no judder); re-aiming mid-flight starts the
+// new tween from the CURRENT width, so reversals are soft.
+
+namespace {
+double easeInOutSine(double t) {
+  return 0.5 - 0.5 * std::cos(M_PI * t);
+}
+}  // namespace
+
+void Ring::startBarReveal(double target, int dur_ms) {
+  bar_from_w_ = bar_shown_w_;
+  bar_target_w_ = target;
+  bar_dur_ms_ = dur_ms;
+  bar_t0_us_ = g_get_monotonic_time();
+  if (bar_tick_id_ == 0) {
+    bar_tick_id_ = bar_box_.add_tick_callback(sigc::mem_fun(*this, &Ring::barTick));
+  }
+}
+
+bool Ring::barTick(const Glib::RefPtr<Gdk::FrameClock>& clock) {
+  const gint64 now = clock->get_frame_time();
+  double t = bar_dur_ms_ > 0 ? static_cast<double>(now - bar_t0_us_) / 1000.0 / bar_dur_ms_ : 1.0;
+  if (t >= 1.0) {
+    t = 1.0;
+  }
+  if (t < 0.0) {
+    t = 0.0;
+  }
+  bar_shown_w_ = bar_from_w_ + (bar_target_w_ - bar_from_w_) * easeInOutSine(t);
+  bar_box_.set_size_request(static_cast<int>(bar_shown_w_ + 0.5), -1);
+  if (t >= 1.0) {
+    bar_tick_id_ = 0;
+    if (bar_state_ == BarState::Opening) {
+      bar_state_ = BarState::Open;
+    } else if (bar_state_ == BarState::Closing) {
+      bar_box_.hide();
+      bar_state_ = BarState::Closed;
+      bar_current_.clear();
+    }
+    return false;
+  }
+  return true;
+}
+
+void Ring::delayWorker() {
+  if (!config_["exec"].isString() && !config_["exec-if"].isString()) {
+    dp.emit();
+    return;
+  }
+
+  thread_ = [this] {
+    for (auto it = this->pid_children_.begin(); it != this->pid_children_.end();) {
+      int status = 0;
+      const auto pid = static_cast<pid_t>(*it);
+      const auto waited = waitpid(pid, &status, WNOHANG);
+      if (waited == 0) {
+        ++it;
+        continue;
+      }
+      if (waited == -1 && errno != ECHILD) {
+        ++it;
+        continue;
+      }
+      it = this->pid_children_.erase(it);
+    }
+
+    bool can_update = true;
+    if (config_["exec-if"].isString()) {
+      output_ = util::command::execNoRead(config_["exec-if"].asString());
+      if (output_.exit_code != 0) {
+        can_update = false;
+        dp.emit();
+      }
+    }
+    if (can_update) {
+      if (config_["exec"].isString()) {
+        output_ = util::command::exec(config_["exec"].asString(), output_name_);
+      }
+      dp.emit();
+    }
+    thread_.sleep_for(interval_);
+  };
+}
+
+void Ring::continuousWorker() {
+  continuous_stream_ = std::make_unique<util::command::LineStream>(
+      output_name_,
+      [this](const std::string& output) {
+        output_ = {.exit_code = 0, .out = output};
+        dp.emit();
+      },
+      [this](int exit_code) { handleContinuousProcessExit(exit_code); });
+  startContinuousProcess(true);
+}
+
+void Ring::startContinuousProcess(bool throw_on_failure) {
+  const auto cmd = config_["exec"].asString();
+
+  try {
+    continuous_stream_->start(cmd);
+  } catch (const Glib::SpawnError& e) {
+    if (throw_on_failure) {
+      throw std::runtime_error("Unable to open " + cmd + ": " + e.what().raw());
+    }
+    output_ = {.exit_code = 1, .out = ""};
+    dp.emit();
+    spdlog::error("Unable to restart {}: {}", name_, e.what().raw());
+    scheduleContinuousRestart();
+  } catch (const std::exception& e) {
+    if (throw_on_failure) {
+      throw;
+    }
+    output_ = {.exit_code = 1, .out = ""};
+    dp.emit();
+    spdlog::error("Unable to restart {}: {}", name_, e.what());
+    scheduleContinuousRestart();
+  }
+}
+
+void Ring::handleContinuousProcessExit(int exit_code) {
+  if (exit_code != 0) {
+    output_ = {.exit_code = exit_code, .out = ""};
+    dp.emit();
+    spdlog::error("{} stopped unexpectedly, is it endless?", name_);
+  }
+
+  scheduleContinuousRestart();
+}
+
+void Ring::scheduleContinuousRestart() {
+  restart_connection_.disconnect();
+  if (!config_["restart-interval"].isNumeric() || config_["restart-interval"].asDouble() <= 0) {
+    // A non-positive restart-interval must not busy-respawn the script
+    // (that starves the GTK main loop); treat it as "do not restart".
+    return;
+  }
+
+  restart_connection_ = Glib::signal_timeout().connect(
+      [this] {
+        startContinuousProcess(false);
+        return false;
+      },
+      std::max(1U, static_cast<unsigned>(config_["restart-interval"].asDouble() * 1000)));
+}
+
+void Ring::waitingWorker() {
+  thread_ = [this] {
+    bool can_update = true;
+    if (config_["exec-if"].isString()) {
+      output_ = util::command::execNoRead(config_["exec-if"].asString());
+      if (output_.exit_code != 0) {
+        can_update = false;
+        dp.emit();
+      }
+    }
+    if (can_update) {
+      if (config_["exec"].isString()) {
+        output_ = util::command::exec(config_["exec"].asString(), output_name_);
+      }
+      dp.emit();
+    }
+    thread_.sleep();
+  };
+}
+
+void Ring::refresh(int sig) {
+#ifdef SIGRTMIN
+  if (config_["signal"].isInt() && sig == SIGRTMIN + config_["signal"].asInt()) {
+    thread_.wake_up();
+  }
+#endif
+}
+
+void Ring::handleEvent() {
+  if (!config_["exec-on-event"].isBool() || config_["exec-on-event"].asBool()) {
+    thread_.wake_up();
+  }
+}
+
+bool Ring::handleScroll(GdkEventScroll* e) {
+  auto ret = AModule::handleScroll(e);
+  handleEvent();
+  return ret;
+}
+
+bool Ring::handleToggle(GdkEventButton* const& e) {
+  auto ret = AModule::handleToggle(e);
+  handleEvent();
+  return ret;
+}
+
+auto Ring::update() -> void {
+  if ((config_["exec"].isString() || config_["exec-if"].isString()) &&
+      (output_.out.empty() || output_.exit_code != 0)) {
+    event_box_.hide();
+  } else {
+    parseOutputJson();
+
+    // Icon color: the matugen accent, like the bar's other icons;
+    // warning/critical take the same tints the sys widgets already
+    // use for their text (#ffdf72 / #ff7280 in style.css). A
+    // script-provided "icon-color" (state-driven states that live
+    // in the script, e.g. dictation recording or muted volume)
+    // wins over all of the above.
+    std::string icon_color =
+        config_["icon-color"].isString() ? config_["icon-color"].asString() : "waybar-accent";
+    for (auto const& c : class_) {
+      if (c == "critical") {
+        icon_color = "#ff7280";
+      } else if (c == "warning") {
+        icon_color = "#ffdf72";
+      }
+    }
+    if (!icon_color_json_.empty()) {
+      icon_color = icon_color_json_;
+    }
+    canvas_.setIcon(text_, icon_color);
+    canvas_.setPercentage(percentage_);
+    if (!bar_.empty()) {
+      if (bar_state_ == BarState::Closed || bar_state_ == BarState::Closing) {
+        // (Re)open: show the box FIRST (a label measured while
+        // its chain is hidden reports width 0), then measure the
+        // fresh markup and unroll to it.
+        bar_label_.set_markup(bar_);
+        bar_current_ = bar_;
+        bar_box_.show();
+        int min_w = 0, nat_w = 0;
+        bar_label_.get_preferred_width(min_w, nat_w);
+        bar_state_ = BarState::Opening;
+        startBarReveal(static_cast<double>(nat_w) + 6.0, 750);
+      } else if (bar_ != bar_current_) {
+        // Open (or opening) and the content changed (the level
+        // moved): swap the markup in place and re-aim the width.
+        bar_label_.set_markup(bar_);
+        bar_current_ = bar_;
+        int min_w = 0, nat_w = 0;
+        bar_label_.get_preferred_width(min_w, nat_w);
+        const double want = static_cast<double>(nat_w) + 6.0;
+        if (std::abs(want - bar_target_w_) > 2.0) {
+          startBarReveal(want, 750);
+        }
+      }
+    } else if (bar_state_ == BarState::Open || bar_state_ == BarState::Opening) {
+      // Roll back up; the label hides only when fully closed.
+      bar_state_ = BarState::Closing;
+      startBarReveal(0.0, 650);
+    }
+    if (tooltipEnabled()) {
+      event_box_.set_tooltip_markup(tooltip_);
+    }
+
+    auto style = wrap_.get_style_context();
+    for (auto const& c : style->list_classes()) {
+      if (c == MODULE_CLASS) {
+        continue;
+      }
+      style->remove_class(c);
+    }
+    for (auto const& c : class_) {
+      style->add_class(c);
+    }
+    event_box_.show();
+  }
+  AModule::update();
+}
+
+void Ring::parseOutputJson() {
+  std::istringstream output(output_.out);
+  std::string line;
+  class_.clear();
+  auto sanitize = [](const std::string& s) -> Glib::ustring {
+    Glib::ustring value = s;
+    if (!value.validate()) {
+      value = value.make_valid();
+    }
+    return value;
+  };
+  while (getline(output, line)) {
+    auto parsed = parser_.parse(line);
+    text_ = sanitize(parsed["text"].asString());
+    tooltip_ = sanitize(parsed["tooltip"].asString());
+    if (parsed["class"].isString()) {
+      class_.push_back(parsed["class"].asString());
+    } else if (parsed["class"].isArray()) {
+      for (auto const& c : parsed["class"]) {
+        class_.push_back(c.asString());
+      }
+    }
+    if (parsed["percentage"].isNumeric()) {
+      percentage_ = static_cast<int>(lround(parsed["percentage"].asFloat()));
+    } else {
+      percentage_ = 0;
+    }
+    icon_color_json_ =
+        parsed["icon-color"].isString() ? parsed["icon-color"].asString() : "";
+    bar_ = sanitize(parsed["bar"].asString());
+    break;
+  }
+}
+
+}  // namespace waybar::modules
