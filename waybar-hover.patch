+// ── WaveCanvas ─────────────────────────────────────────────────────
+// The user's final word on the shape (2026-11-08): DOTS — round
+// like the ● of the segmented level dots — never bars, not even
+// small ones. Each column is a filled circle centered on the
+// middle line; the level drives its DIAMETER (curve v^1.35, from
+// ~3 px at rest to 20 px at full, so the big dots really read).
+// The columns are INSET from the canvas edges by the max radius,
+// so a fully grown dot is never clipped at the sides. The color
+// comes from a DYNAMIC gradient: a cyclic sweep between matugen
+// theme colors whose phase keeps rolling (a full turn in ~10 s),
+// so no dot keeps one color — the tonalities travel the row.
+
+WaveCanvas::WaveCanvas() {
+  // 25 ms tick (2026-11-09): the ONLY draw pacer, so frames land
+  // evenly at 40 fps. Per tick it advances the rolling phase by
+  // half the old step (same ~10 s turn) and eases the displayed
+  // dot values halfway toward the latest data frame — the
+  // interpolation the user asked for: data arrives at ~30 fps in
+  // bursts, the dots glide instead of jumping. Mic modes snap
+  // (their own designs carry their own motion).
+  Glib::signal_timeout().connect(
+      [this]() {
+        ++tick_;
+        phase_ = std::fmod(phase_ + 0.0025, 1.0);
+        if (!values_.empty()) {
+          if (disp_.size() != values_.size() || onda_ || chispas_ || simbolos_ || estela_) {
+            disp_ = values_;
+          } else {
+            for (size_t i = 0; i < disp_.size(); ++i) {
+              disp_[i] += (values_[i] - disp_[i]) * 0.5;
+            }
+          }
+          queue_draw();
+        }
+        return true;
+      },
+      25);
+}
