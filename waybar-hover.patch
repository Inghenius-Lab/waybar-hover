+inline void i_investigando(X& x, double t) {
+  const double r = 17;
+  struct Cosa {
+    double z;
+    int tipo;
+    P a, b;
+  };
+  std::vector<Cosa> cosas;
+  cosas.reserve(90);
+  for (int i = 0; i < 3; i++) {
+    Tr T = [&, i](const P& p) { return pr(rY(rZ(rX(p, 1.2), i * PI / 3), t * .6)); };
+    const auto o = anillo(r, 28, T);
+    for (int k = 0; k < 28; k++) cosas.push_back({(o[k][2] + o[(k + 1) % 28][2]) / 2, 0, o[k], o[(k + 1) % 28]});
+    const double a = t * 2.6 + i * 2.1;
+    const P e = T({r * std::cos(a), r * std::sin(a), 0});
+    cosas.push_back({e[2], 1, e, e});
+  }
+  cosas.push_back({0, 2, {0, 0, 0}, {0, 0, 0}});
+  std::stable_sort(cosas.begin(), cosas.end(), [](const Cosa& p, const Cosa& q) { return p.z < q.z; });
+  x.lw = 1.5;
+  for (const auto& c : cosas) {
+    if (c.tipo == 0) {
+      seg(x, c.a, c.b, r);
+    } else if (c.tipo == 1) {
+      x.ga = 1;
+      circ(x, c.a[0], c.a[1], 1.5 + .7 * (c.z / r + 1) / 2, true);
+    } else {
+      x.ga = 1;
+      circ(x, C, C, 3, true);
+      const Col fs = x.fs;
+      x.fs = x.pal.blanco;
+      x.ga = .8;
+      circ(x, C - 1, C - 1, .9, true);
+      x.fs = fs;
+    }
+  }
+  x.ga = 1;
+}
+
+inline void i_esfera(X& x, double t) {
+  const double r = 10.5;
+  struct An {
+    double ra, ix, iz, a;
+  };
+  const An an[2] = {{17.5, 1.25, -.45, t * 2}, {14.5, 1.15, .8, -t * 1.5 + 1}};
+  struct Del {
+    bool punto;
+    P a, b;
+  };
+  std::vector<Del> del;
+  auto tapa = [&](const P& p) { return p[2] < 0 && std::hypot(p[0] - C, p[1] - C) < r; };
+  x.lw = 1.4;
+  for (const auto& e : an) {
+    Tr T = [&](const P& p) { return pr(rY(rZ(rX(p, e.ix), e.iz), .5 * std::sin(t * .5))); };
+    const auto o = anillo(e.ra, 30, T);
+    const P s = T({e.ra * std::cos(e.a), e.ra * std::sin(e.a), 0});
+    for (int k = 0; k < 30; k++) {
+      const P& p = o[k];
+      const P& q = o[(k + 1) % 30];
+      if (p[2] + q[2] > 0) {
+        del.push_back({false, p, q});
+      } else if (!tapa(p) && !tapa(q)) {
+        seg(x, p, q, e.ra, .7);
+      }
+    }
+    if (s[2] > 0) {
+      del.push_back({true, s, s});
+    } else if (!tapa(s)) {
+      x.ga = .5;
+      circ(x, s[0], s[1], 1.5, true);
+    }
+  }
+  x.ga = .2;
+  circ(x, C, C, r, true);
+  x.ga = 1;
+  x.lw = 2;
+  circ(x, C, C, r);
+  x.lw = 1.3;
+  x.ga = .75;
+  x.begin();
+  x.arc(C, C, r * .66, PI * 1.08, PI * 1.55);
+  x.stroke();
+  x.lw = 1.5;
+  for (const auto& d : del) {
+    if (!d.punto) {
+      seg(x, d.a, d.b, 17);
+    } else {
+      x.ga = 1;
+      circ(x, d.a[0], d.a[1], 2, true);
+    }
+  }
+  x.ga = 1;
+}
+
+inline void i_leyendo(X& x, double t) {
+  const double w = 14, hy = 10.5, f0 = .42;
+  auto T = [&](const P& p) { return pr(rX(rY(p, .22 * std::sin(t * .6)), .42), 0, -1); };
+  auto hoja = [&](double psi) -> std::vector<P> {
+    const double cx = w * std::cos(psi), cz = w * std::sin(psi);
+    return {T({0, -hy, 0}), T({cx, -hy, cz}), T({cx, hy, cz}), T({0, hy, 0})};
+  };
+  auto texto = [&](double psi, double al) {
+    x.lw = 1.3;
+    const double ys[4] = {-5.5, -1.5, 2.5, 6.5};
+    for (double y : ys) {
+      const double a = .22, b = y > 6 ? .6 : .84;
+      seg(x, T({w * a * std::cos(psi), y, w * a * std::sin(psi)}), T({w * b * std::cos(psi), y, w * b * std::sin(psi)}), 14, al);
+    }
+  };
+  const double psis[2] = {f0, PI - f0};
+  for (double psi : psis) {
+    const auto h = hoja(psi);
+    relleno(x, h, .1);
+    x.lw = 2;
+    poli(x, h, 14, 1, true);
+    texto(psi, .6);
+  }
+  const double p = suave(std::fmod(t * .42, 1.0) * 1.7), psi = f0 + (PI - 2 * f0) * p;
+  if (p > .02 && p < .98) {
+    const auto h = hoja(psi);
+    relleno(x, h, .16);
+    x.lw = 1.6;
+    poli(x, h, 14, 1, true);
+  }
+  x.ga = 1;
+}
+
+inline void i_editando(X& x, double t) {
+  const double p = std::min(1.0, std::fmod(t * .42, 1.25)), tx = -14 + 23 * p;
+  auto fy = [](double u) { return 14 + 1.7 * std::sin(u * 1.1); };
+  x.lw = 1.8;
+  x.ga = 1;
+  x.begin();
+  for (double u = -14; u <= tx + .01; u += 1) x.lt(C + u, C + fy(u));
+  x.lt(C + tx, C + fy(tx));
+  x.stroke();
+  util(x, tx, fy(tx),
+       {{0, .3, x.pal.blanco}, {1.9, 1, x.pal.verde}, {5.5, 2.9, x.pal.verde}, {20, 2.9, x.pal.azul},
+        {22.5, 2.9, x.pal.rosa}, {24.5, 2.9, x.pal.rosa}},
+       6, t * 2.2, .56, -.38);
+}
+
+inline void i_creando(X& x, double t) {
+  Tr T = [&](const P& p) { return pr(rZ(rY(rX(p, .95), .45 * std::sin(t * .9)), -.18), -1, 5); };
+  auto forma = [&](double z) {
+    std::vector<P> o;
+    o.reserve(30);
+    for (int i = 0; i < 30; i++) {
+      const double a = i * TAU / 30, m = 1 - .2 * std::exp(-((a - 2.5) * (a - 2.5)) * 5);
+      o.push_back(T({17 * m * std::cos(a), 13.5 * m * std::sin(a), z}));
+    }
+    return o;
+  };
+  const auto arr = forma(1.2);
+  x.lw = 1.2;
+  poli(x, forma(-1.2), 18, .4, true);
+  relleno(x, arr, .13);
+  x.lw = 2;
+  poli(x, arr, 18, 1, true);
+  x.lw = 1.4;
+  poli(x, anillo(2.6, 10, [&](const P& p) { return T({p[0] - 7.5, p[1] + 5, 1.2}); }), 18, 1, true);
+  struct M {
+    double mx, my;
+    Col col;
+  };
+  const M ms[4] = {{-9, -5, x.pal.azul}, {-2, -8.5, x.pal.blanco}, {5.5, -7.5, x.pal.ambar}, {11, -2.5, x.pal.rosa}};
+  const Col base = x.ss;
+  for (const auto& m : ms) {
+    x.fs = m.col;
+    relleno(x, anillo(2.5, 10, [&](const P& p) { return T({p[0] + m.mx, p[1] + m.my, 1.2}); }), .95);
+  }
+  const int k = static_cast<int>(std::floor(t * .8)) % 4;
+  const double sube = 4 * std::abs(std::sin(t * .8 * PI));
+  const P b = T({ms[k].mx, ms[k].my, 1.2 + sube});
+  util(x, b[0] - C, b[1] - C,
+       {{0, .3, ms[k].col}, {2.6, 1.9, ms[k].col}, {5, 1.5, x.pal.blanco}, {7.5, 1.3, base}, {19, .9, base}},
+       6, t, .5, -.5);
+  x.ambos(base);
+}
+
+inline void i_creando2(X& x, double t) {
+  const Col base = x.ss;
+  const double u = std::fmod(t * .38, 1.3), p = std::min(1.0, u), al = u > 1 ? 1 - (u - 1) / .3 : 1;
+  auto Pq = [](double q) -> std::array<double, 2> {
+    return {-15 + 29 * q, 9 + 6.5 * std::sin(q * TAU * .95 + .4) * (1 - .25 * q)};
+  };
+  x.ss = x.pal.azul;
+  for (int i = 0; i < 28; i++) {
+    const double q0 = i / 28.0, q1 = (i + 1) / 28.0;
+    if (q0 >= p) break;
+    const auto a = Pq(q0), b = Pq(std::min(q1, p));
+    x.ga = .7 * al;
+    x.lw = 2.4 + 2.6 * std::sin(PI * std::min(1.0, q0 * 1.15 + .12));
+    linea(x, C + a[0], C + a[1], C + b[0], C + b[1]);
+  }
+  x.ss = x.pal.blanco;
+  x.lw = 1.1;
+  const double des[2][3] = {{-13, -9, 0}, {-6, -15, 2.1}};
+  for (const auto& d : des) {
+    const double s = 2.6 * std::abs(std::sin(t * 2.3 + d[2]));
+    x.ga = .9;
+    linea(x, C + d[0] - s, C + d[1], C + d[0] + s, C + d[1]);
+    linea(x, C + d[0], C + d[1] - s, C + d[0], C + d[1] + s);
+  }
+  const auto e = Pq(p);
+  util(x, e[0], e[1],
+       {{0, .3, x.pal.azul}, {3, 2.5, x.pal.azul}, {5.5, 2, x.pal.azul}, {6, 2, x.pal.blanco},
+        {9, 1.9, x.pal.blanco}, {9.5, 1.5, base}, {23, 1, base}},
+       6, t * 1.2, .5 + .12 * std::sin(p * 6), -.42);
+  x.ambos(base);
+}
